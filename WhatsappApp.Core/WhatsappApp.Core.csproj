  <ItemGroup>
    <!-- A reference to the entire .Net Framework and Windows SDK are automatically included -->
  </ItemGroup>
  <ItemGroup>
    <!--
      The code has not moved: these folders stay under WhatsappApp/ because that is
      where the readers, the guards and the documents of this repository look for
      them,and
      a tree relocated for one build is not worth the noise. What
      compiles it is a single library: the app and the background task must run
      *the same* code (same Signal sessions, same files), and two copies in two
      assemblies would be two clients stepping on each other on disk. The app
      therefore no longer lists these files: it takes them from here.
    -->
    <Compile Include="..\WhatsappApp\Protocol\**\*.cs">
      <Link>Protocol\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\WhatsappApp\Services\**\*.cs">
      <Link>Services\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\WhatsappApp\Models\**\*.cs">
      <Link>Models\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <!-- The section of the home screen: SessionService names it too, and remembers
         it between two starts, so the type is needed on both sides of the split.
         It is an enum, not a control. -->
    <Compile Include="..\WhatsappApp\Controls\AppSection.cs">
      <Link>Controls\AppSection.cs</Link>
    </Compile>
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <PropertyGroup Condition=" '$(VisualStudioVersion)' == '' or '$(VisualStudioVersion)' &lt; '12.0' ">
