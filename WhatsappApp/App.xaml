<Application
    x:Class="WhatsappApp.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone">

    <Application.ApplicationLifetimeObjects>
        <shell:PhoneApplicationService />
    </Application.ApplicationLifetimeObjects>

    <Application.Resources>
        <ResourceDictionary>
            <!-- Keep the WP8 dark-phone chrome; Accent.Apply reads the platform accent. -->

            <SolidColorBrush x:Key="WhatsAppDarkTealBrush" Color="#FF075E54"/>
            <SolidColorBrush x:Key="WhatsAppTealBrush" Color="#FF087A77"/>
            <SolidColorBrush x:Key="WhatsAppGreenBrush" Color="#FF25D366"/>
            <SolidColorBrush x:Key="WhatsAppLightGreenBrush" Color="#FF123B39"/>
            <SolidColorBrush x:Key="WhatsAppChatBgBrush" Color="#FF000000"/>
            <SolidColorBrush x:Key="WhatsAppHomeVeilBrush" Color="#D9000000"/>
            <SolidColorBrush x:Key="WhatsAppBlueBrush" Color="#FF21B8B5"/>

            <!-- Incoming content uses the phone accent; sent content is its dark XAP shade. -->
            <SolidColorBrush x:Key="ChatIncomingBrush" Color="#FF25D366"/>
            <SolidColorBrush x:Key="ChatOutgoingBrush" Color="#FF108942"/>
            <SolidColorBrush x:Key="ChatBubbleMetaBrush" Color="#99FFFFFF"/>

            <Color x:Key="WhatsAppHeaderColor">#FF000000</Color>
            <Color x:Key="WhatsAppAppBarColor">#FF1B1B1B</Color>
            <Color x:Key="WhatsAppSentBubbleColor">#FF108942</Color>
            <SolidColorBrush x:Key="WhatsAppHeaderBrush" Color="{StaticResource WhatsAppHeaderColor}"/>
            <SolidColorBrush x:Key="WhatsAppAccentBrush" Color="#FF25D366"/>
            <SolidColorBrush x:Key="WhatsAppAccentDarkBrush" Color="#FF108942"/>
            <SolidColorBrush x:Key="WhatsAppAccentTextBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="WhatsAppAppBarBrush" Color="{StaticResource WhatsAppAppBarColor}"/>
            <SolidColorBrush x:Key="WhatsAppSentBubbleBrush" Color="{StaticResource WhatsAppSentBubbleColor}"/>
            <SolidColorBrush x:Key="WhatsAppReceivedBubbleBrush" Color="#FF25D366"/>
            <SolidColorBrush x:Key="WhatsAppTextPrimaryBrush" Color="#FFFFFFFF"/>
            <SolidColorBrush x:Key="WhatsAppTextSecondaryBrush" Color="#FF939393"/>
            <SolidColorBrush x:Key="WhatsAppSeparatorBrush" Color="#FF262626"/>

            <!-- Silverlight phone controls supply the original Segoe WP typography and compact chrome. -->
        </ResourceDictionary>
    </Application.Resources>

</Application>
