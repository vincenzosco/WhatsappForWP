<Page
    x:Class="WhatsappApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WhatsappApp.Converters"
    Background="White">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <!-- Cells without padding or animations: the grid is 40+ thumbnails and a
             low-end WP8.1 phone should not do more work than it draws. -->
        <Style x:Key="ThemeItemContainerStyle" TargetType="GridViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The same secondary header as the account page: white, a back arrow and
             the title, so a page reached from the app bar does not look like part
             of another app. -->
        <Grid Grid.Row="0" Background="White" Height="72">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,12,0,0" Padding="0"
                    Click="BackButton_Click"
                    BorderThickness="0">
                <Path Stroke="#FF333333" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Uid="Settings_Title" Grid.Column="1" Text="Impostazioni"
                       Foreground="#FF333333" FontSize="40" FontFamily="Segoe WP Semilight"
                       VerticalAlignment="Center" Margin="8,0,0,4"/>
        </Grid>

        <!-- The wallpapers are the released package's own (Images/Wallpapers),
             thumbnail and all: one tap paints the conversation and the list. The
             grid scrolls on its own, so the header and the account button travel
             with it instead of sitting in two more fixed rows on a 480 px screen. -->
        <GridView x:Name="ThemeGrid" Grid.Row="1"
                  Background="Transparent"
                  Padding="12,0,12,12"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="ThemeGrid_ItemClick"
                  ItemContainerStyle="{StaticResource ThemeItemContainerStyle}">
            <GridView.ItemsPanel>
                <ItemsPanelTemplate>
                    <ItemsWrapGrid Orientation="Horizontal"
                                   ItemWidth="144" ItemHeight="196"/>
                </ItemsPanelTemplate>
            </GridView.ItemsPanel>

            <GridView.Header>
                <StackPanel Margin="4,8,4,6">
                    <TextBlock x:Uid="Settings_ThemeLabel" Text="Tema"
                               Foreground="{StaticResource WhatsAppAccentBrush}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Uid="Settings_ThemeHint"
                               Text="Lo sfondo delle chat e dell'elenco. La scelta vale per tutta l'app."
                               Foreground="#FF606060" FontSize="13" TextWrapping="Wrap"
                               Margin="0,2,0,0"/>
                </StackPanel>
            </GridView.Header>

            <GridView.ItemTemplate>
                <DataTemplate>
                    <Grid Width="132" Height="184" Margin="6,0,6,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="140"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- The square the thumbnail fills. A wallpaper the package
                             does not carry (plain white) leaves the "Aa" showing,
                             which is what the background looks like. -->
                        <Border Grid.Row="0" Background="#FFF4F4F4" CornerRadius="4">
                            <Grid>
                                <TextBlock x:Uid="Settings_ThemePlainSample" Text="Aa"
                                           FontSize="40" FontFamily="Segoe WP Semilight"
                                           Foreground="#FFBDBDBD"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Image Source="{Binding ThumbUri}" Stretch="UniformToFill"/>
                                <Border BorderThickness="2" BorderBrush="Transparent" CornerRadius="4"/>
                                <Border Width="28" Height="28" CornerRadius="14"
                                        Background="{StaticResource WhatsAppAccentBrush}"
                                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,8,8"
                                        Visibility="{Binding Selected, Converter={StaticResource BoolToVisibility}}">
                                    <Path Stroke="White" StrokeThickness="2"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Width="14" Height="14"
                                          HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <!-- IconCheck -->
                                        <Path.Data>
                                            <PathGeometry>
                                                <PathGeometry.Figures>
                                                    <PathFigure StartPoint="2,7">
                                                        <PathFigure.Segments>
                                                            <PolyLineSegment Points="5.5,10.5 12,3.5"/>
                                                        </PathFigure.Segments>
                                                    </PathFigure>
                                                </PathGeometry.Figures>
                                            </PathGeometry>
                                        </Path.Data>
                                    </Path>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Grid.Row="1" Text="{Binding Name}"
                                   Foreground="#FF333333" FontSize="15"
                                   TextTrimming="WordEllipsis"
                                   HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </Grid>
                </DataTemplate>
            </GridView.ItemTemplate>

            <GridView.Footer>
                <StackPanel Margin="4,8,4,24">
                    <TextBlock x:Uid="Settings_AccountLabel" Text="Account"
                               Foreground="{StaticResource WhatsAppAccentBrush}"
                               FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Uid="Settings_AccountHint"
                               Text="Il numero collegato, lo stato della connessione e il collegamento di un altro telefono."
                               Foreground="#FF606060" FontSize="13" TextWrapping="Wrap"
                               Margin="0,2,0,8"/>
                    <Button x:Name="AccountButton" x:Uid="Settings_AccountButton"
                            Content="Account e connessione"
                            Background="{StaticResource WhatsAppAccentBrush}"
                            Foreground="White" FontSize="18" FontWeight="SemiBold"
                            Height="52" BorderThickness="0"
                            HorizontalAlignment="Stretch"
                            Click="AccountButton_Click"/>
                </StackPanel>
            </GridView.Footer>
        </GridView>
    </Grid>
</Page>
