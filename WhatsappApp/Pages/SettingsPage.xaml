<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:toolkit="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone.Controls.Toolkit"
    xmlns:pages="clr-namespace:WhatsappApp.Pages"
    Background="#FF000000">

    <phone:PhoneApplicationPage.Resources>
        <!-- The reference toggle: a flat 64 x 28 rectangle with a 2 px white
             border, the accent fill and the square thumb when it is on, and the
             empty track with the thumb at the left when it is off. The plain
             CheckBox carries the IsChecked and Checked/Unchecked surface the
             page already uses; only the look is ours. -->
        <Style x:Key="SettingsToggleStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Unchecked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="0" Duration="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ToggleThumb"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                             To="38" Duration="0:0:0"/>
                                            <DoubleAnimation Storyboard.TargetName="ToggleFill"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Indeterminate"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid Width="64" Height="28">
                                <Rectangle x:Name="ToggleFill" Stroke="White" StrokeThickness="2"
                                           Fill="{StaticResource WhatsAppAccentBrush}" Opacity="0"/>
                                <Rectangle Stroke="White" StrokeThickness="2" Fill="Transparent"/>
                                <Border x:Name="ToggleThumb" Background="White" Width="20" Height="20"
                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                        Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <pages:ThemeThumbnailConverter x:Key="ThemeThumbnail"/>
        <pages:ThemePlainSampleConverter x:Key="ThemePlainSample"/>
    </phone:PhoneApplicationPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image x:Name="PageWallpaper" Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="2" Fill="#E6000000"/>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent" Foreground="White"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,6,0,0" Padding="0"
                    Click="BackButton_Click" BorderThickness="0">
                <Path Stroke="#FFFFFFFF" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="TitleText" Grid.Column="1"
                       Foreground="White" FontSize="23" FontFamily="Segoe WP Semilight"
                       VerticalAlignment="Bottom" Margin="8,0,0,10"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,4,24,24">
                <TextBlock x:Name="ThemeLabel" Foreground="White"
                           FontSize="24" FontWeight="SemiBold" FontFamily="Segoe WP Semibold"/>
                <TextBlock x:Name="ThemeHint" Foreground="#FFB0B0B0"
                           FontSize="13" TextWrapping="Wrap" Margin="0,2,0,6"/>

                <ListBox x:Name="ThemeGrid" Background="Transparent" BorderThickness="0"
                         SelectionChanged="ThemeGrid_ItemClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="56" Margin="0,2,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="48" Height="48"
                                        CornerRadius="24" Background="#FF242424">
                                    <Grid>
                                        <Image Source="{Binding ThumbUri, Converter={StaticResource ThemeThumbnail}}"
                                               Stretch="UniformToFill"/>
                                        <TextBlock Text="{Binding ThumbUri, Converter={StaticResource ThemePlainSample}}"
                                                   Foreground="#FFBDBDBD" FontSize="18"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                           Foreground="White" FontSize="18"
                                           VerticalAlignment="Center" Margin="12,0,0,0"
                                           TextTrimming="WordEllipsis"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock x:Name="AlertsLabel" Foreground="White"
                           FontSize="24" FontWeight="SemiBold" FontFamily="Segoe WP Semibold" Margin="0,18,0,0"/>
                <TextBlock x:Name="AlertsHint" Foreground="#FFB0B0B0"
                           FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"/>

                <TextBlock x:Name="MessagesLabel" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="MessagesToggleState" Foreground="White"
                               FontSize="28" FontFamily="Segoe WP Semilight"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource SettingsToggleStyle}" x:Name="MessagesToggle" Grid.Column="1"
                                          Foreground="#FF00AFA9" VerticalAlignment="Center"
                                          Checked="MessagesToggle_Toggled"
                                          Unchecked="MessagesToggle_Toggled"/>
                </Grid>

                <TextBlock x:Name="StatusesLabel" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusesToggleState" Foreground="White"
                               FontSize="28" FontFamily="Segoe WP Semilight"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource SettingsToggleStyle}" x:Name="StatusesToggle" Grid.Column="1"
                                          Foreground="#FF00AFA9" VerticalAlignment="Center"
                                          Checked="StatusesToggle_Toggled"
                                          Unchecked="StatusesToggle_Toggled"/>
                </Grid>

                <TextBlock x:Name="CallsLabel" Foreground="White"
                           FontSize="17" FontWeight="SemiBold" Margin="0,16,0,0"/>
                <Grid Margin="0,2,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CallsToggleState" Foreground="White"
                               FontSize="28" FontFamily="Segoe WP Semilight"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource SettingsToggleStyle}" x:Name="CallsToggle" Grid.Column="1"
                                          Foreground="#FF00AFA9" VerticalAlignment="Center"
                                          Checked="CallsToggle_Toggled"
                                          Unchecked="CallsToggle_Toggled"/>
                </Grid>

                <TextBlock x:Name="BackgroundLabel" Foreground="White"
                           FontSize="24" FontWeight="SemiBold" FontFamily="Segoe WP Semibold"/>
                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BackgroundToggleState" Foreground="White"
                               FontSize="28" FontFamily="Segoe WP Semilight"
                               VerticalAlignment="Center"/>
                    <CheckBox Style="{StaticResource SettingsToggleStyle}" x:Name="BackgroundToggle" Grid.Column="1"
                                          Foreground="#FF00AFA9" VerticalAlignment="Center"
                                          Checked="BackgroundToggle_Toggled"
                                          Unchecked="BackgroundToggle_Toggled"/>
                </Grid>
                <TextBlock x:Name="BackgroundHint" Foreground="#FFB0B0B0"
                           FontSize="13" TextWrapping="Wrap" Margin="0,4,0,4"/>
                <TextBlock x:Name="BackgroundState" Foreground="#FFFF6B6B"
                           FontSize="13" TextWrapping="Wrap" Margin="0,0,0,12"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="AccountLabel" Foreground="White"
                           FontSize="24" FontWeight="SemiBold" FontFamily="Segoe WP Semibold"/>
                <TextBlock x:Name="AccountHint" Foreground="#FFB0B0B0"
                           FontSize="13" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <Grid>
                    <Rectangle Height="1" Fill="#40FFFFFF" VerticalAlignment="Top"/>
                    <Button x:Name="AccountButton" Content=""
                            Background="Transparent" Foreground="White"
                            FontSize="24" FontFamily="Segoe WP Semilight"
                            MinWidth="0" MinHeight="0" Height="56" BorderThickness="0"
                            Padding="0" HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="AccountButton_Click"/>
                    <Path Stroke="#FFB0B0B0" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="12" Height="20" HorizontalAlignment="Right"
                          VerticalAlignment="Center" IsHitTestVisible="False">
                        <!-- IconChevron -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="2,2">
                                        <PathFigure.Segments>
                                            <PolyLineSegment Points="10,10 2,18"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    <Rectangle Height="1" Fill="#40FFFFFF" VerticalAlignment="Bottom"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
