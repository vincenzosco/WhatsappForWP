<Page
    x:Class="WhatsappApp.Pages.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFECE5DD">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar, the same green as the sections: this is a page of the app,
             not a dialog in front of one. -->
        <Grid Grid.Row="0" Background="#FF075E54" Height="56">
            <TextBlock x:Uid="PairPage_Title" Text="Link this phone"
                       Margin="16,0,16,0" VerticalAlignment="Center"
                       FontSize="24" Foreground="White" TextTrimming="CharacterEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,12">

                <!-- The text is black on purpose, not the theme's foreground: this page
                     has a light background of its own (#FFECE5DD), so on a phone set to
                     the dark theme the default white text was white on beige. -->
                <TextBlock x:Uid="PairPage_Instructions" Text="Open WhatsApp on your phone, go to Settings, Linked devices, Link a device, and scan this code. The code changes every few seconds on its own: keep the camera on it."
                           Foreground="#FF000000" TextWrapping="Wrap" FontSize="15"/>

                <!-- The code. Its size is fixed by the drawer (four pixels per module
                     plus the quiet zone), so no Stretch: a scaled QR is a blurred one,
                     and a blurred one is a scan that fails. -->
                <Image x:Name="QrImage" Margin="0,16,0,16" HorizontalAlignment="Center"/>

                <TextBlock x:Uid="PairPage_Waiting" Text="Waiting for the scan..."
                           Foreground="#FF000000" TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"/>

                <!-- Shown instead of the waiting line when the codes have run out, or
                     when WhatsApp refused the session this phone had stored. -->
                <TextBlock x:Name="ExpiredText" x:Uid="PairPage_ExpiredSession" Text="This code has expired. Ask for a new one and scan that."
                           Foreground="#FF000000" TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="ErrorText" x:Uid="PairPage_Error" Text="The connection to WhatsApp failed. Check that this phone has a network and try again."
                           Foreground="#FF000000" TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>

            </StackPanel>
        </ScrollViewer>

        <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="True" Margin="16,0,16,0"/>

        <Button x:Name="RetryButton" x:Uid="PairPage_Retry" Grid.Row="3"
                Content="Try again" Margin="16,12,16,20"
                HorizontalAlignment="Stretch" Visibility="Collapsed"
                Click="RetryButton_Click"/>

    </Grid>
</Page>
