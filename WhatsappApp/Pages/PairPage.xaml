<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.PairPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000" Orientation="Portrait">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="PageWallpaper" Grid.RowSpan="4"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="4" Fill="#CC000000"/>

        <Grid Grid.Row="0" Background="Transparent">
            <TextBlock x:Name="TitleText" Margin="16,-10,16,-6" VerticalAlignment="Bottom"
                       FontSize="54" FontFamily="Segoe WP Semilight" Foreground="White"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,12">
                <TextBlock x:Name="InstructionsText" Foreground="#FFE0E0E0"
                           TextWrapping="Wrap" FontSize="16"/>
                <Border HorizontalAlignment="Center" Background="White" Padding="8" Margin="0,16,0,16">
                    <Image x:Name="QrImage" Stretch="None"/>
                </Border>
                <TextBlock x:Name="WaitingText" Foreground="#FFB0B0B0"
                           TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"/>
                <TextBlock x:Name="ExpiredText" Foreground="#FFB0B0B0"
                           TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFFF6B6B"
                           TextWrapping="Wrap" FontSize="15" HorizontalAlignment="Center"
                           Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <ProgressBar x:Name="BusyBar" Grid.Row="2" IsIndeterminate="True"
                     Foreground="#FF00AFA9" Margin="16,0,16,0"/>

        <Button x:Name="RetryButton" Grid.Row="3" Content=""
                Background="#FF00AFA9" Foreground="White" Margin="16,12,16,20"
                HorizontalAlignment="Stretch" Visibility="Collapsed"
                Click="RetryButton_Click"/>
    </Grid>
</phone:PhoneApplicationPage>
