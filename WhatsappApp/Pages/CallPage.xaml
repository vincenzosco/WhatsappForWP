<Page
    x:Class="WhatsappApp.Pages.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF101010">

    <Page.Resources>
        <!-- The call tiles of callscreenpage.xaml: full-bleed in their cell, the
             theme minimums zeroed, so the two of the ringing screen split it
             exactly in half and the end bar takes the whole width. -->
        <Style x:Key="CallTileStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Segoe WP Semilight"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <!-- La chiamata a tutto schermo, sulla geometria della pagina ufficiale: la
         foto occupa i primi 555 px (il numero e' scritto "Match native" nel
         decompilato), i due gradienti la fanno scendere nel nero sotto, e il nome
         sta in basso a sinistra a 88 px sopra lo stato e il tipo di chiamata.
         Non e' il banner della home page: quello resta per quando questa pagina e'
         stata chiusa con il tasto indietro, e dice la stessa cosa in una striscia. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="555"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- L'area della foto: al suo posto il cerchio delle iniziali, perche' questa
             build non ha ancora la foto del contatto da mostrare qui. -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF1F1F1F"/>

            <Grid Width="220" Height="220"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="220" Height="220" Fill="#FF2A2A2A"/>
                <TextBlock x:Name="InitialsText"
                           Foreground="White" FontSize="64" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- I due gradienti della pagina ufficiale: 120 px di nero in alto per
                 lo stato del telefono, 200 px in basso perche' il nome si legga
                 sopra qualunque foto. -->
            <Rectangle Height="120" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#99000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="200" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#33000000" Offset="0.4"/>
                        <GradientStop Color="#66000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- Il testo della pagina ufficiale: stato e durata sulla stessa riga a 28
             px SemiBold, il nome a 88, il numero (qui il tipo di chiamata) sotto. -->
        <StackPanel Grid.Row="0" Margin="24,0,0,30"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateText"
                           Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="DurationText"
                           Foreground="White" FontSize="28" FontWeight="SemiBold"
                           Margin="12,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="NameText"
                       Foreground="White" FontSize="88" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxHeight="240"
                       Margin="0,-8,0,-6"/>

            <TextBlock x:Name="KindText"
                       Foreground="White" FontSize="28"/>

            <!-- La frase che dice cosa questa build non fa: una chiamata muta
                 deve essere una riga sullo schermo, non un bug da cercare. -->
            <TextBlock x:Name="NoteText"
                       Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap"
                       MaxWidth="300" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- I pulsanti, sulle griglie della pagina ufficiale: righe da 84 px con 6
             px di cucitura per una chiamata che squilla, 94 per una in corso. Le
             due griglie stanno una sopra l'altra e a decidere chi si vede e' la
             visibilita' dei singoli pulsanti, che il codice gia' governa. -->
        <Grid Grid.Row="1" Margin="0,6,0,0">

            <Grid x:Name="CallIncomingButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AcceptCallButton" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FF25D366" Click="AcceptCall_Click"/>

                <Button x:Name="DeclineCallButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CallTileStyle}"
                        Click="DeclineCall_Click"/>
            </Grid>

            <Grid x:Name="CallInProgressButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Nella pagina ufficiale questa barra occupa tre colonne e la
                     quarta e' il pulsante "messaggio": qui non c'e' un messaggio da
                     mandare durante la chiamata, quindi la barra prende tutta la
                     larghezza invece di lasciare un buco. -->
                <Button x:Name="EndCallButton" Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FF25D366" Click="EndCall_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
