<Page
    x:Class="WhatsappApp.Pages.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF101010">

    <Page.Resources>
        <!-- Full-bleed tiles: theme minimums zeroed so the rows split exactly. -->
        <Style x:Key="CallTileStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Segoe WP Semilight"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <!-- The call in full screen: picture on top, text below, buttons under it. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="555"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The picture, or the initials until the picture is decoded. -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF1F1F1F"/>

            <Grid Width="220" Height="220"
                  HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="AvatarCircle" Width="220" Height="220" Fill="#FF2A2A2A"/>
                <TextBlock x:Name="InitialsText"
                           Foreground="White" FontSize="64" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- The two gradients, so the name reads over any picture. -->
            <Rectangle Height="120" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#99000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="200" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#33000000" Offset="0.4"/>
                        <GradientStop Color="#66000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- State and duration on one line, the name under them, the kind below. -->
        <StackPanel Grid.Row="0" Margin="24,0,0,30"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateText"
                           Foreground="White" FontSize="28" FontWeight="SemiBold"/>
                <TextBlock x:Name="DurationText"
                           Foreground="White" FontSize="28" FontWeight="SemiBold"
                           Margin="12,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="NameText"
                       Foreground="White" FontSize="88" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxHeight="240"
                       Margin="0,-8,0,-6"/>

            <TextBlock x:Name="KindText"
                       Foreground="White" FontSize="28"/>

            <!-- A silent call says so, instead of looking like a bug. -->
            <TextBlock x:Name="NoteText"
                       Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap"
                       MaxWidth="300" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Two grids, one over the other: the code shows the one the state calls for. -->
        <Grid Grid.Row="1" Margin="0,6,0,0">

            <Grid x:Name="CallIncomingButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="84"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AcceptCallButton" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FF25D366" Click="AcceptCall_Click"/>

                <Button x:Name="DeclineCallButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CallTileStyle}"
                        Click="DeclineCall_Click"/>
            </Grid>

            <Grid x:Name="CallInProgressButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- The whole width: there is no message button during a call here. -->
                <Button x:Name="EndCallButton" Grid.Row="2" Grid.Column="0"
                        Grid.ColumnSpan="5"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FF25D366" Click="EndCall_Click"/>
            </Grid>
        </Grid>
    </Grid>
</Page>
