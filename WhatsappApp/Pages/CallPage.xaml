<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000" Orientation="Portrait">

    <phone:PhoneApplicationPage.Resources>
        <!-- The rectangular call tiles use their grid cell size, not the theme button minimums. -->
        <Style x:Key="CallTileStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe WP Semilight"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--
                            The tile dims while it is held. A custom template owns its own
                            states: with no `CommonStates` group here the button answered the
                            touch with nothing at all, and a control that gives no sign is
                            pressed twice - which on a call screen is the hang-up tapped
                            after it already worked. The dim covers the tile and its glyph
                            together so the whole button responds to the press. `Disabled` is here for the
                            same reason: the state a template does not declare is a state
                            the button silently ignores.
                        -->
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid x:Name="Tile">
                                <Rectangle Fill="{TemplateBinding Background}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The glyph of a call control: an outline that reads on every tile colour. -->
        <Style x:Key="CallGlyphStyle" TargetType="Path">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <!-- The call in full screen: picture on top, text below, buttons under it. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- The picture takes the space left after the reference-sized controls. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The picture, or the initials until the picture is decoded. -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF080808"/>
            <Image x:Name="CallPhoto" Stretch="UniformToFill" Visibility="Collapsed"/>
            <Rectangle Fill="#55000000"/>

            <!-- The picture sits near the top, above the name and the call state. -->
            <Grid Width="180" Height="180" Margin="0,20,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Ellipse x:Name="AvatarCircle" Width="180" Height="180" Fill="#FF2A2A2A"/>
                <TextBlock x:Name="InitialsText"
                           Foreground="White" FontSize="56" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- The two gradients, so the name reads over any picture. -->
            <Rectangle Height="120" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#99000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="200" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#33000000" Offset="0.4"/>
                        <GradientStop Color="#66000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <!-- The reference top line: the WhatsApp call mark and its name. -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                        HorizontalAlignment="Left" Margin="24,14,24,0">
                <Image x:Name="CallHeaderIcon"
                       Source="/Assets/Reference/ThemeDark/phone-solid.png"
                       Width="20" Height="20" Stretch="Uniform"/>
                <TextBlock x:Name="CallHeaderText" Text=""
                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

        </Grid>

        <!-- State and duration on one line, the name under them, the kind below. -->
        <StackPanel Grid.Row="0" Margin="24,0,0,24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateText"
                           Foreground="#FFB0B0B0" FontSize="20" FontFamily="Segoe WP Semilight"/>
                <TextBlock x:Name="DurationText"
                           Foreground="#FFB0B0B0" FontSize="20" FontFamily="Segoe WP Semilight"
                           Margin="12,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="NameText"
                       Foreground="White" FontSize="56" FontFamily="Segoe WP Semilight"
                       TextWrapping="Wrap" MaxHeight="160"
                       Margin="0,-4,0,0"/>

            <TextBlock x:Name="KindText"
                       Foreground="#FFB0B0B0" FontSize="20" FontFamily="Segoe WP Semilight"/>

            <!-- A silent call says so, instead of looking like a bug. -->
            <TextBlock x:Name="NoteText"
                       Foreground="#FF8E8E8E" FontSize="15" TextWrapping="Wrap"
                       MaxWidth="330" Margin="0,10,0,0"
                       Visibility="Collapsed"/>

            <!--
                The media path, in the numbers the transport already keeps: which pair was
                nominated, where the handshake is, and what has crossed the socket. It sits under
                the note and is drawn by the same one-second tick as the duration, because none
                of these numbers raises an event: a datagram arrives and a handshake step moves
                without a stanza being sent about either.
            -->
            <TextBlock x:Name="MediaText"
                       Foreground="#FF8E8E8E" FontSize="13" TextWrapping="Wrap"
                       MaxWidth="330" Margin="0,6,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Controls are arranged in the same two rows as the reference call screen. -->
        <Grid Grid.Row="1" Margin="0,10,0,26">

            <!-- Incoming calls expose the supported answer and decline actions. -->
            <Grid x:Name="CallIncomingButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="84"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AcceptCallButton" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CallTileStyle}"
                        Background="{StaticResource WhatsAppAccentBrush}" Click="AcceptCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <TextBlock x:Name="AcceptLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DeclineCallButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FFE0413A" Click="DeclineCallButton_Click">
                    <StackPanel>
                        <!-- The same handset, laid down: refusing is the phone put back. -->
                        <Path Style="{StaticResource CallGlyphStyle}"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform Angle="135"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="DeclineLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- A live call uses two rows: audio controls above, message and hang-up below. -->
            <Grid x:Name="CallInProgressButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="94"/>
                    <RowDefinition Height="6"/>
                    <RowDefinition Height="94"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="6"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MuteCallButton" Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource CallTileStyle}" Click="MuteCallButton_Click">
                    <StackPanel>
                        <Image Source="/Assets/Reference/ThemeDark/mute-call.png"
                               Width="42" Height="42" Stretch="Uniform"/>
                        <TextBlock x:Name="MuteLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SpeakerCallButton" Grid.Row="0" Grid.Column="0"
                        Style="{StaticResource CallTileStyle}" Click="SpeakerCallButton_Click">
                    <StackPanel>
                        <Image Source="/Assets/Reference/ThemeDark/speaker.png"
                               Width="42" Height="42" Stretch="Uniform"/>
                        <TextBlock x:Name="SpeakerLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>

                <!-- The chat opens without ending the call. -->
                <Button x:Name="MessageCallButton" Grid.Row="2" Grid.Column="4"
                        Style="{StaticResource CallTileStyle}" Click="MessageCallButton_Click">
                    <StackPanel>
                        <Image Source="/Assets/Reference/ThemeDark/message.png"
                               Width="42" Height="42" Stretch="Uniform"/>
                        <TextBlock x:Name="MessageLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>

                <!-- Hang up is the left action in the lower row; message stays on the right. -->
                <Button x:Name="EndCallButton" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Style="{StaticResource CallTileStyle}"
                        Background="#FFE0413A" Click="EndCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform Angle="135"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="EndLabel" FontSize="14" Margin="0,4,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="94"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
