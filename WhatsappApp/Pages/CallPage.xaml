<Page
    x:Class="WhatsappApp.Pages.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF101010">

    <!-- La chiamata a tutto schermo. Non e' il banner della home page: quello
         resta per quando questa pagina e' stata chiusa con il tasto indietro, e
         dice la stessa cosa in una striscia. Qui c'e' il posto per un nome, un
         numero e il tempo che la chiamata dura. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="KindText" Grid.Row="0"
                   Foreground="#B0FFFFFF" FontSize="15"
                   HorizontalAlignment="Center" Margin="24,28,24,0"/>

        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="140" Height="140">
                <Ellipse Width="140" Height="140" Fill="#FF2A2A2A"/>
                <TextBlock x:Name="InitialsText"
                           Foreground="White" FontSize="48" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <TextBlock x:Name="NameText"
                       Foreground="White" FontSize="28" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextTrimming="WordEllipsis"
                       Margin="24,18,24,0"/>

            <TextBlock x:Name="StateText"
                       Foreground="#B0FFFFFF" FontSize="17"
                       HorizontalAlignment="Center" Margin="24,6,24,0"/>

            <TextBlock x:Name="DurationText"
                       Foreground="#B0FFFFFF" FontSize="17"
                       HorizontalAlignment="Center" Margin="24,2,24,0"
                       Visibility="Collapsed"/>

            <!-- La frase che dice cosa questa build non fa: una chiamata muta
                 deve essere una riga sullo schermo, non un bug da cercare. -->
            <TextBlock x:Name="NoteText"
                       Foreground="#80FFFFFF" FontSize="13" TextWrapping="Wrap"
                       TextAlignment="Center" MaxWidth="300"
                       HorizontalAlignment="Center" Margin="24,18,24,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center" Margin="0,0,0,36">
            <Button x:Name="AcceptCallButton" Click="AcceptCall_Click"
                    Background="#FF25D366" Foreground="White" BorderThickness="0"
                    MinWidth="0" MinHeight="0" Width="112" Height="52" Padding="0"
                    FontSize="16" Margin="6"/>
            <Button x:Name="DeclineCallButton" Click="DeclineCall_Click"
                    Background="#FFC62828" Foreground="White" BorderThickness="0"
                    MinWidth="0" MinHeight="0" Width="112" Height="52" Padding="0"
                    FontSize="16" Margin="6"/>
            <Button x:Name="EndCallButton" Click="EndCall_Click"
                    Background="#FF3A3A3A" Foreground="White" BorderThickness="0"
                    MinWidth="0" MinHeight="0" Width="112" Height="52" Padding="0"
                    FontSize="16" Margin="6"/>
        </StackPanel>
    </Grid>
</Page>
