<Page
    x:Class="WhatsappApp.Pages.CallPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FF101010">

    <Page.Resources>
        <!--
            The round control of a call screen. Everything the theme would add is zeroed,
            because these are drawn where the page puts them and the WP8.1 theme minimums
            (109 x 57.5) would otherwise widen the row and push the neighbours together.

            The circle is drawn by the template and not by `CornerRadius`: the WP8.1
            projection has no such member on a button (the build answers
            `WMC0090: Unknown member 'CornerRadius' on element 'Button'`), and an ellipse
            filled with the button's own Background is the same circle with nothing to
            guess at - which is also what lets `PaintSwitch` light it.
        -->
        <Style x:Key="CallRoundStyle" TargetType="Button">
            <Setter Property="Background" Value="#FF2A2A2A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="116"/>
            <Setter Property="Height" Value="116"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe WP Semilight"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!--
                            The tile dims while it is held. A custom template owns its own
                            states: with no `CommonStates` group here the button answered the
                            touch with nothing at all, and a control that gives no sign is
                            pressed twice - which on a call screen is the hang-up tapped
                            after it already worked. The dim is on the whole tile - circle
                            and glyph together - because dimming only the glyph would leave
                            a lit circle that looks untouched. `Disabled` is here for the
                            same reason: the state a template does not declare is a state
                            the button silently ignores.
                        -->
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid x:Name="Tile">
                                <Ellipse Fill="{TemplateBinding Background}"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The glyph of a round control: an outline, so it reads on any tile colour. -->
        <Style x:Key="CallGlyphStyle" TargetType="Path">
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="1.6"/>
            <Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <!-- The call in full screen: picture on top, text below, buttons under it. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- The picture takes whatever is left once the controls have theirs. A fixed
                 575 px row asked for more than this screen had after the buttons grew, and
                 the row of circles was cut at the bottom edge - the glyphs first, because
                 they sit in the upper half of each tile. The controls are `Auto`, so they
                 are never the ones that lose. -->
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- The picture, or the initials until the picture is decoded. -->
        <Grid Grid.Row="0">
            <Rectangle Fill="#FF1F1F1F"/>

            <!-- The picture sits near the top and not in the middle of the row: the name is
                 written under it, and on a short screen a centred circle would be the thing
                 that gets clipped when the controls claim their height. -->
            <Grid Width="260" Height="260" Margin="0,20,0,0"
                  HorizontalAlignment="Center" VerticalAlignment="Top">
                <Ellipse x:Name="AvatarCircle" Width="260" Height="260" Fill="#FF2A2A2A"/>
                <TextBlock x:Name="InitialsText"
                           Foreground="White" FontSize="80" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Grid>

            <!-- The two gradients, so the name reads over any picture. -->
            <Rectangle Height="120" VerticalAlignment="Top">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#99000000" Offset="0.0"/>
                        <GradientStop Color="#00000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Height="200" VerticalAlignment="Bottom">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                        <GradientStop Color="#00000000" Offset="0.0"/>
                        <GradientStop Color="#33000000" Offset="0.4"/>
                        <GradientStop Color="#66000000" Offset="1.0"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
        </Grid>

        <!-- State and duration on one line, the name under them, the kind below. -->
        <StackPanel Grid.Row="0" Margin="24,0,0,24"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom">

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StateText"
                           Foreground="White" FontSize="32" FontWeight="SemiBold"/>
                <TextBlock x:Name="DurationText"
                           Foreground="White" FontSize="32" FontWeight="SemiBold"
                           Margin="12,0,0,0" Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock x:Name="NameText"
                       Foreground="White" FontSize="96" FontWeight="SemiBold"
                       TextWrapping="Wrap" MaxHeight="240"
                       Margin="0,-8,0,-6"/>

            <TextBlock x:Name="KindText"
                       Foreground="White" FontSize="32"/>

            <!-- A silent call says so, instead of looking like a bug. -->
            <TextBlock x:Name="NoteText"
                       Foreground="#80FFFFFF" FontSize="15" TextWrapping="Wrap"
                       MaxWidth="330" Margin="0,10,0,0"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- The controls: one row each, the code shows the row the state calls for. -->
        <Grid Grid.Row="1" Margin="0,10,0,26">

            <!--
                A call that came in: answer on the left, refuse on the right, and nothing
                else. A person with a ringing phone has one decision, and the other
                switches would be three more things to read before making it.
            -->
            <Grid x:Name="CallIncomingButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="AcceptCallButton" Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CallRoundStyle}"
                        Background="#FF25D366" Click="AcceptCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <TextBlock x:Name="AcceptLabel" FontSize="16" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="DeclineCallButton" Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CallRoundStyle}"
                        Background="#FFE0413A" Click="DeclineCallButton_Click">
                    <StackPanel>
                        <!-- The same handset, laid down: refusing is the phone put back. -->
                        <Path Style="{StaticResource CallGlyphStyle}"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform Angle="135"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="DeclineLabel" FontSize="16" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!--
                A call that is up, or being set up: the three controls of a telephone, in the
                order a hand looks for them, with the hang-up rightmost and red.
            -->
            <Grid x:Name="CallInProgressButtons">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="MuteCallButton" Grid.Row="1" Grid.Column="0"
                        Style="{StaticResource CallRoundStyle}" Click="MuteCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}">
                            <!-- IconMicrophone -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="10,7" IsClosed="True">
                                            <PathFigure.Segments>
                                                <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Clockwise" Point="14,7"/>
                                                <LineSegment Point="14,12"/>
                                                <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Clockwise" Point="10,12"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="7,11">
                                            <PathFigure.Segments>
                                                <ArcSegment Size="5,5" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Counterclockwise" Point="17,11"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="12,16">
                                            <PathFigure.Segments>
                                                <LineSegment Point="12,19"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="9,19">
                                            <PathFigure.Segments>
                                                <LineSegment Point="15,19"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <TextBlock x:Name="MuteLabel" FontSize="16" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button x:Name="SpeakerCallButton" Grid.Row="1" Grid.Column="2"
                        Style="{StaticResource CallRoundStyle}" Click="SpeakerCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}">
                            <!-- IconSpeaker -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="3,9" IsClosed="True">
                                            <PathFigure.Segments>
                                                <LineSegment Point="7,9"/>
                                                <LineSegment Point="12,4"/>
                                                <LineSegment Point="12,20"/>
                                                <LineSegment Point="7,15"/>
                                                <LineSegment Point="3,15"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="15,9">
                                            <PathFigure.Segments>
                                                <ArcSegment Size="3,3" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Clockwise" Point="15,15"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="18,6">
                                            <PathFigure.Segments>
                                                <ArcSegment Size="6,6" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Clockwise" Point="18,18"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <TextBlock x:Name="SpeakerLabel" FontSize="16" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- The hang-up: red, rightmost, where the thumb lands by itself. -->
                <Button x:Name="EndCallButton" Grid.Row="1" Grid.Column="4"
                        Style="{StaticResource CallRoundStyle}"
                        Background="#FFE0413A" Click="EndCallButton_Click">
                    <StackPanel>
                        <Path Style="{StaticResource CallGlyphStyle}"
                              RenderTransformOrigin="0.5,0.5">
                            <!-- IconCall -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="19.5,20" IsClosed="True">
                                            <PathFigure.Segments>
                                                <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                                <LineSegment Point="7.5,4.5"/>
                                                <LineSegment Point="9,9"/>
                                                <LineSegment Point="7,11"/>
                                                <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                                <LineSegment Point="15,15"/>
                                                <LineSegment Point="19.5,16.5"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                            <Path.RenderTransform>
                                <RotateTransform Angle="135"/>
                            </Path.RenderTransform>
                        </Path>
                        <TextBlock x:Name="EndLabel" FontSize="16" Margin="0,5,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
