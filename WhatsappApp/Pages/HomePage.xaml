<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:conv="clr-namespace:WhatsappApp.Converters"
    xmlns:controls="clr-namespace:WhatsappApp.Controls"
    xmlns:shell="clr-namespace:Microsoft.Phone.Shell;assembly=Microsoft.Phone"
    Background="Black" Orientation="Portrait"
    shell:SystemTray.IsVisible="True"
>

    <phone:PhoneApplicationPage.Resources>
        <conv:UnreadCountToVisibilityConverter x:Key="UnreadToVisibility"/>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <shell:ApplicationBar x:Key="ChatsApplicationBar" IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton x:Name="SearchAppBarButton" x:Uid="Home_SearchAppBarButton" IconUri="/Assets/Reference/search.png" Text="Search" Click="SearchApplicationBarButton_Click"/>
            <shell:ApplicationBarIconButton x:Name="NewChatAppBarButton" x:Uid="Home_NewChatAppBarButton" IconUri="/Assets/Reference/add.png" Text="New chat" Click="NewChatApplicationBarButton_Click"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem x:Uid="Home_ReadAllAppBarMenuItem" Text="Read all chats" Click="ReadAllAppBarMenuItem_Click"/>
                <shell:ApplicationBarMenuItem x:Uid="Home_PinChatsAppBarMenuItem" Text="Pin chats" Click="PinChatsAppBarMenuItem_Click"/>
                <shell:ApplicationBarMenuItem x:Uid="Home_UnpinAllAppBarMenuItem" Text="Unpin all" Click="UnpinAllAppBarMenuItem_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
        <shell:ApplicationBar x:Key="StatusApplicationBar" IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton x:Name="RefreshStatusAppBarButton" x:Uid="Home_RefreshStatusAppBarButton" IconUri="/Assets/Reference/refresh.png" Text="Refresh" Click="RefreshStatusApplicationBarButton_Click"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem x:Uid="Home_MarkStatusesAppBarMenuItem" Text="Mark all as viewed" Click="MarkAllStatusesAppBarMenuItem_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
        <shell:ApplicationBar x:Key="CallsApplicationBar" IsVisible="True" IsMenuEnabled="True">
            <shell:ApplicationBarIconButton x:Name="NewCallAppBarButton" x:Uid="Home_NewCallAppBarButton" IconUri="/Assets/Reference/ThemeDark/phone-solid.png" Text="Start a voice call" Click="NewCallButton_Click"/>
            <shell:ApplicationBar.MenuItems>
                <shell:ApplicationBarMenuItem x:Uid="Home_RefreshCallsAppBarMenuItem" Text="Refresh" Click="RefreshCallsAppBarMenuItem_Click"/>
                <shell:ApplicationBarMenuItem x:Uid="Home_MarkCallsAppBarMenuItem" Text="Mark all as seen" Click="MarkCallsAppBarMenuItem_Click"/>
                <shell:ApplicationBarMenuItem x:Uid="Home_SettingsAppBarMenuItem" Text="Settings" Click="SettingsAppBarMenuItem_Click"/>
            </shell:ApplicationBar.MenuItems>
        </shell:ApplicationBar>
        <!--
            The bottom bar the reference client shows: a row of outlined circles
            with the glyph inside, and the overflow as plain dots at the right
            edge. The template draws the circle (a button has no CornerRadius on
            this projection) and dims the whole tile while it is held - a control
            that gives no sign of the press is tapped twice.
        -->
        <Style x:Key="AppBarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid x:Name="Tile" Width="46" Height="46">
                                <Ellipse Fill="{TemplateBinding Background}"
                                         Stroke="White" StrokeThickness="1.5"/>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverflowButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="MouseOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Tile"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.4" Duration="0:0:0"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                            <Grid x:Name="Tile">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AppBarLabelStyle" TargetType="TextBlock">
            <!-- Hidden: the reference circles carry no label under the glyph.
                 The text is still set, because it is the name a long press
                 reads and the automation layer announces. -->
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontFamily" Value="Segoe WP Semilight"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </phone:PhoneApplicationPage.Resources>

    <Grid x:Name="PageRoot" Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Image x:Name="HomeWallpaper" Grid.RowSpan="3" Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Visibility="Collapsed"/>
        <Rectangle Grid.RowSpan="3" Fill="#D9000000"/>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid x:Name="SearchPanel" Grid.Row="0" Background="#FF15191A" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" Margin="14,5,4,5">
                    <TextBox x:Name="SearchBox" Background="Transparent" Foreground="White"
                             BorderThickness="0" FontSize="18" TextChanged="SearchBox_TextChanged"/>
                    <TextBlock x:Name="SearchPrompt" Foreground="#FF92999A" FontSize="18"
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                </Grid>
                <Button x:Name="CloseSearchButton" Grid.Column="1" Width="46" Height="46"
                        MinWidth="0" MinHeight="0" Padding="0" BorderThickness="0"
                        Background="Transparent" Click="CloseSearchButton_Click">
                    <Grid Width="14" Height="14">
                        <Rectangle Width="2" Height="18" Fill="#FFD9E1E1">
                            <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                        </Rectangle>
                        <Rectangle Width="2" Height="18" Fill="#FFD9E1E1">
                            <Rectangle.RenderTransform><RotateTransform Angle="-45"/></Rectangle.RenderTransform>
                        </Rectangle>
                    </Grid>
                </Button>
                <Rectangle Grid.Column="2" Width="1" Fill="#FF303839" Margin="0,8"/>
            </Grid>

            <Border x:Name="PendingAttachmentBar" Grid.Row="1" Background="#FF123B3A"
                    Padding="12,7" Visibility="Collapsed">
                <TextBlock x:Name="PendingAttachmentText" Foreground="#FFE8FFFF" FontSize="13"
                           TextWrapping="Wrap"/>
            </Border>

            <phone:Pivot x:Name="Sections" Grid.Row="2" Background="Transparent"
                          SelectionChanged="Sections_SelectionChanged" Title="WHATSAPP">
                <phone:PivotItem>
                    <phone:PivotItem.Header>
                        <TextBlock x:Uid="Nav_ChatsHeader" Text="chats"/>
                    </phone:PivotItem.Header>
                    <Grid Background="Transparent" Margin="12,0,12,0">
                        <phone:LongListSelector x:Name="ChatListView" Background="Transparent" Margin="0,0,0,0"
                                                SelectionChanged="ChatListView_SelectionChanged">
                            <phone:LongListSelector.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="68" Margin="0,24,24,0" Background="Transparent"
                                          ManipulationStarted="ChatRow_Holding"
                                          ManipulationCompleted="ChatRow_ManipulationCompleted">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid x:Name="ChatAvatar" Grid.Column="0" Width="68" Height="68"
                                              Margin="0" VerticalAlignment="Top">
                                            <Ellipse Width="68" Height="68"
                                                     Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                                            <Ellipse Width="68" Height="68"
                                                     Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="22"
                                                       FontWeight="SemiBold" VerticalAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                                            <TextBlock Text="{Binding Name}" Foreground="White" FontSize="32"
                                                       FontFamily="Segoe WP Semilight" TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding LastMessage}" Foreground="#FF939393" FontSize="20"
                                                       TextTrimming="WordEllipsis" MaxHeight="28"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0,14,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Grid Width="8" Height="11" Margin="0,0,4,0"
                                                      Visibility="{Binding IsPinned, Converter={StaticResource BoolToVisibility}}">
                                                    <Ellipse Width="6" Height="4" Fill="{StaticResource WhatsAppAccentBrush}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                                    <Rectangle Width="2" Height="6" Fill="{StaticResource WhatsAppAccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Bottom"/>
                                                </Grid>
                                                <Grid Width="10" Height="10" Margin="0,0,4,0"
                                                      Visibility="{Binding IsMuted, Converter={StaticResource BoolToVisibility}}">
                                                    <Ellipse Width="9" Height="9" Stroke="#FF92999A" StrokeThickness="1"/>
                                                    <Rectangle Width="11" Height="1" Fill="#FF92999A">
                                                        <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                                    </Rectangle>
                                                </Grid>
                                                <TextBlock Text="{Binding LastMessageTime}" Foreground="#FF939393" FontSize="18.667"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding UnreadCount}" Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="14"
                                                       HorizontalAlignment="Right"
                                                       Visibility="{Binding UnreadCount, Converter={StaticResource UnreadToVisibility}}"/>
                                        </StackPanel>
                                        <Rectangle Grid.Column="1" Grid.ColumnSpan="2" Height="1" Fill="#FF1F1F1F"
                                                   VerticalAlignment="Bottom"/>
                                    </Grid>
                                </DataTemplate>
                            </phone:LongListSelector.ItemTemplate>
                        </phone:LongListSelector>

                        <Border x:Name="ConnectionBar" Background="#FF8B5615" VerticalAlignment="Top"
                                Visibility="Collapsed">
                            <TextBlock x:Name="ConnectionBarText" Foreground="White" FontSize="13"
                                       TextWrapping="Wrap" Margin="12,7"/>
                        </Border>

                        <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                    VerticalAlignment="Center" HorizontalAlignment="Center">
                            <Ellipse Width="42" Height="42" Stroke="#FF566061" StrokeThickness="2"
                                     HorizontalAlignment="Center"/>
                            <TextBlock x:Name="EmptyTitleText" Foreground="#FFB0B8B9" FontSize="18"
                                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            <TextBlock x:Name="EmptyHintText" Foreground="#FF788182" FontSize="14"
                                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
                            <Button x:Name="DiagnosticsButton"
                                    Background="#FF202728" Foreground="#FFE6EEEE" FontSize="14"
                                    Height="40" MinWidth="0" MinHeight="0" BorderThickness="0"
                                    Margin="0,14,0,0" HorizontalAlignment="Center"
                                    Click="DiagnosticsButton_Click"/>
                        </StackPanel>
                    </Grid>
                </phone:PivotItem>
                <phone:PivotItem x:Uid="Nav_StatusesHeader" Header="statuses">
                    <controls:StatusPane Margin="12,0,12,0" x:Name="StatusView"/>
                </phone:PivotItem>
                <phone:PivotItem x:Uid="Nav_CallsHeader" Header="calls">
                    <controls:CallsPane Margin="12,0,12,0" x:Name="CallsView"/>
                </phone:PivotItem>
            </phone:Pivot>
        </Grid>

        <Border x:Name="CallBanner" Grid.RowSpan="3" Background="#EE171717" Padding="14,9"
                VerticalAlignment="Top" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="CallTitleText" Foreground="White" FontSize="17"
                               FontFamily="Segoe WP Semilight" TextTrimming="WordEllipsis"/>
                    <TextBlock x:Name="CallDetailText" Foreground="#FFB4BDBE" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="32"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="AcceptCallButton" Click="AcceptCall_Click" Background="{StaticResource WhatsAppAccentBrush}"
                            Foreground="White" BorderThickness="0" MinWidth="0" MinHeight="0"
                            Height="38" Padding="12,0" FontSize="14" Margin="3,0"/>
                    <Button x:Name="DeclineCallButton" Click="DeclineCall_Click" Background="#FF9B3035"
                            Foreground="White" BorderThickness="0" MinWidth="0" MinHeight="0"
                            Height="38" Padding="12,0" FontSize="14" Margin="3,0"/>
                    <Button x:Name="EndCallButton" Click="EndCall_Click" Background="#FF9B3035"
                            Foreground="White" BorderThickness="0" MinWidth="0" MinHeight="0"
                            Height="38" Padding="12,0" FontSize="14" Margin="3,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Background="#FF171717" MinHeight="64" Visibility="Collapsed">
            <Rectangle Height="1" VerticalAlignment="Top" Fill="#FF303030"/>
            <Grid x:Name="ChatsBar">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="SearchButton" Style="{StaticResource AppBarButtonStyle}" Click="SearchButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Left" VerticalAlignment="Top" Margin="1,1,0,0"/>
                                <Rectangle Width="10" Height="2" Fill="White" HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom" Margin="0,0,0,2">
                                    <Rectangle.RenderTransform><RotateTransform Angle="45"/></Rectangle.RenderTransform>
                                </Rectangle>
                            </Grid>
                            <TextBlock x:Name="SearchLabel" Style="{StaticResource AppBarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="NewChatButton" Style="{StaticResource AppBarButtonStyle}" Click="NewChatButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <!-- IconNewChat -->
                            <Grid Width="24" Height="24" HorizontalAlignment="Center">
                                <Rectangle Width="18" Height="2" Fill="White"/>
                                <Rectangle Width="2" Height="18" Fill="White"/>
                            </Grid>
                            <TextBlock x:Name="NewChatLabel" Style="{StaticResource AppBarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource AppBarButtonStyle}" Click="SettingsButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <!-- IconSettings -->
                            <Grid Width="22" Height="22" HorizontalAlignment="Center">
                                <Ellipse Width="16" Height="16" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="5" Height="5" Fill="White"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Width="2" Height="22" Fill="White"/>
                                <Rectangle Width="22" Height="2" Fill="White"/>
                            </Grid>
                            <TextBlock x:Name="SettingsLabel" Style="{StaticResource AppBarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="MoreButton" Style="{StaticResource OverflowButtonStyle}"
                        Click="MoreButton_Click" HorizontalAlignment="Right" MinWidth="0" MinHeight="0">
                    <StackPanel VerticalAlignment="Center">
                        <!-- IconOverflow -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                            <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                            <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        </StackPanel>
                        <TextBlock x:Name="MoreLabel" Style="{StaticResource AppBarLabelStyle}"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="StatusBar" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RefreshStatusButton" Style="{StaticResource AppBarButtonStyle}" Click="RefreshStatusButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="22" Height="22" HorizontalAlignment="Center">
                                <Ellipse Width="17" Height="17" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Width="8" Height="4" Fill="#FF101516" HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                                <Path Stroke="White" StrokeThickness="2">
                                    <!-- IconRefreshStatus -->
                                    <Path.Data>
                                        <PathGeometry><PathGeometry.Figures><PathFigure StartPoint="16,2" IsClosed="True">
                                            <PathFigure.Segments><LineSegment Point="20,2"/><LineSegment Point="19,6"/></PathFigure.Segments>
                                        </PathFigure></PathGeometry.Figures></PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="RefreshStatusLabel" Style="{StaticResource AppBarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="StatusMoreButton" Style="{StaticResource OverflowButtonStyle}"
                        Click="StatusMoreButton_Click" HorizontalAlignment="Right" MinWidth="0" MinHeight="0">
                    <!-- IconOverflow -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                    </StackPanel>
                </Button>
            </Grid>
            <Grid x:Name="CallsBar" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="RefreshCallsButton" Style="{StaticResource AppBarButtonStyle}" Click="RefreshCallsButton_Click">
                        <StackPanel VerticalAlignment="Center">
                            <Grid Width="22" Height="22" HorizontalAlignment="Center">
                                <Ellipse Width="17" Height="17" Stroke="White" StrokeThickness="2"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Rectangle Width="8" Height="4" Fill="#FF101516" HorizontalAlignment="Center"
                                           VerticalAlignment="Top"/>
                                <Path Stroke="White" StrokeThickness="2">
                                    <!-- IconRefreshCalls -->
                                    <Path.Data>
                                        <PathGeometry><PathGeometry.Figures><PathFigure StartPoint="16,2" IsClosed="True">
                                            <PathFigure.Segments><LineSegment Point="20,2"/><LineSegment Point="19,6"/></PathFigure.Segments>
                                        </PathFigure></PathGeometry.Figures></PathGeometry>
                                    </Path.Data>
                                </Path>
                            </Grid>
                            <TextBlock x:Name="RefreshCallsLabel" Style="{StaticResource AppBarLabelStyle}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Button x:Name="CallsMoreButton" Style="{StaticResource OverflowButtonStyle}"
                        Click="CallsMoreButton_Click" HorizontalAlignment="Right" MinWidth="0" MinHeight="0">
                    <!-- IconOverflow -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Grid>

        <Grid x:Name="ModalOverlay" Grid.RowSpan="3" Background="Transparent" Visibility="Collapsed">
            <Button x:Name="ModalDismissButton" Grid.RowSpan="3" Background="Transparent"
                    BorderThickness="0" MinWidth="0" MinHeight="0" Padding="0"
                    Click="ModalDismissButton_Click" Visibility="Collapsed"/>
            <Border x:Name="ModalCard" Background="#FF171717" BorderBrush="{StaticResource WhatsAppAccentBrush}"
                    BorderThickness="1" Margin="8,18" MaxHeight="560" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ModalTitle" Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="24"
                               FontFamily="Segoe WP Semilight" TextWrapping="Wrap" Margin="18,16,18,10"/>
                    <ScrollViewer Grid.Row="1" MaxHeight="390" Margin="18,0">
                        <StackPanel x:Name="ModalContent"/>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="8,12">
                        <Button x:Name="ModalSecondaryButton" MinWidth="0" MinHeight="0" Padding="14,7"
                                Background="Transparent" Foreground="#FFB5C0C1" BorderThickness="0"
                                Click="ModalSecondaryButton_Click"/>
                        <Button x:Name="ModalPrimaryButton" MinWidth="0" MinHeight="0" Padding="14,7"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White" BorderThickness="0" Margin="8,0,0,0"
                                Click="ModalPrimaryButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
