<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.ChatPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:WhatsappApp.Converters"
    xmlns:pages="clr-namespace:WhatsappApp.Pages"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone" Orientation="Portrait">

    <!-- The wallpaper, as the settings page chose it (Services/ThemeService): by
         default the doodle the released app ships in Images/Background.jpg, or one
         of the package's own Images/Wallpapers. It is the page background, so the
         bubbles scroll over it and both the list and the typing bubble see it. -->
    <phone:PhoneApplicationPage.Background>
        <ImageBrush x:Name="ChatWallpaper"
                    ImageSource="/Assets/ChatBackground.jpg"
                    Stretch="UniformToFill"/>
    </phone:PhoneApplicationPage.Background>

    <phone:PhoneApplicationPage.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:MessageStatusToStringConverter x:Key="MsgStatusToString"/>
        <conv:MessageStatusToColorConverter x:Key="MsgStatusToColor"/>
        <conv:MessageTypeToImageVisibilityConverter x:Key="MsgTypeToImageVis"/>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <pages:LocalizedMessageTextConverter x:Key="LocalizedMessageText"/>

        <!-- The brushes are the application's (App.xaml), not this page's: a copy
             here did not follow the phone accent, and its light-green sent bubble
             left the white text of an outgoing message unreadable. -->

        <!-- The three dots of "someone is writing": each one rises and comes back,
             one after the other, and the whole thing repeats for as long as the
             bubble is on screen. It is WhatsApp's animation drawn with three
             ellipses, so nothing has to be decoded to show it, and it is stopped
             (not just hidden) the moment the bubble goes away. -->
        <Storyboard x:Key="TypingDots" RepeatBehavior="Forever">
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingDot1"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                           Duration="0:0:0.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.15" Value="-3.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingDot2"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                           Duration="0:0:0.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="-3.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="TypingDot3"
                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(CompositeTransform.TranslateY)"
                                           Duration="0:0:0.9">
                <EasingDoubleKeyFrame KeyTime="0:0:0" Value="0"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.45" Value="-3.5"/>
                <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="0"/>
            </DoubleAnimationUsingKeyFrames>
        </Storyboard>
    </phone:PhoneApplicationPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <!-- The typing bubble. It is a row of its own, outside the list: a
                 bubble inside the list would be a message the conversation has
                 to scroll past, and it comes and goes on its own. -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header: back + picture + name/status. The picture is a thing of its
             own apart from the name row: tapping it opens it full screen,
             tapping the name opens the contact info. -->
        <Grid Grid.Row="0" Background="Black" Height="84">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,4,0,0" Padding="0"
                    Click="BackButton_Click"
                    BorderThickness="0">
                <Path Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <Grid x:Name="ContactHeader" Grid.Column="2"
                  Background="Transparent"
                  Margin="8,0,0,4"
                  Tap="ContactHeader_Tapped">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="ContactNameText" Text=""
                               Foreground="White" FontSize="54" FontFamily="Segoe WP Semilight"
                               TextTrimming="WordEllipsis"/>
                    <TextBlock x:Name="OnlineStatusText" Text=""
                               Foreground="#B0FFFFFF" FontSize="15" Margin="0,-4,0,0"/>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- Messages -->
        <!-- The item source is bound in code, by ConversationView.Bind, and
             nowhere else: an ItemsSource="{Binding}" here is resolved against
             DataContext (a Contact, not a collection) and fights that writer,
             which left the conversation empty with a run of first chance
             SYSTEM.NI.DLL exceptions and no DIAG line. -->
        <phone:LongListSelector x:Name="MessagesListView" Grid.Row="1"
                                Background="Transparent"
                                IsGroupingEnabled="False"
                                LayoutMode="List">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <!-- The long press is on the whole bubble, incoming and outgoing: it
                         is the only way to reach a message's own actions (copy the text,
                         delete it on this phone) without a button on every row. -->
                    <!-- Margin 24 a destra e a sinistra: sono le due colonne fisse di
                         MessageBubbleContainer (24 * zoom), non un margine scelto a
                         occhio. La bolla ci sta dentro e si ferma a MaxWidth. -->
                    <Grid Margin="24,0,24,0" HorizontalAlignment="Stretch" Hold="Bubble_Holding">
                        <!-- Incoming bubble: a flat rectangle with the 15 x 10
                             tail at its top-left corner, the shape every reference
                             screenshot shows. The three tail points are (0,0),
                             (0,10), (15,10). -->
                        <Polygon Points="0,0 0,10 15,10" Fill="{StaticResource ChatIncomingBrush}"
                                 HorizontalAlignment="Left" VerticalAlignment="Top"
                                 Margin="0,0,0,0"
                                 Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Background="{StaticResource ChatIncomingBrush}"
                                CornerRadius="0"
                                MaxWidth="324"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Visibility="{Binding IsIncoming, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="10,6,10,4">
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Visibility="{Binding Type, Converter={StaticResource MsgTypeToImageVis}}"
                                        MaxWidth="300" MaxHeight="200"
                                        Tap="Media_Tapped">
                                    <Image Source="{Binding MediaImage}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"/>
                                </Border>
                                <!-- A video: a dark box with the triangle, tapped
                                     to open it full screen. Before the bytes it is
                                     the same tap that fetches them. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220" Height="140"
                                        Background="#FF263238"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                        Tap="Media_Tapped">
                                    <Grid>
                                        <!-- The cover frame, when the phone could
                                             make one: with it the box says which
                                             video it is. Without it the dark box
                                             and the triangle stay. -->
                                        <Image Source="{Binding VideoThumbnail}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Path Fill="White" Width="54" Height="54"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- IconPlay -->
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathGeometry.Figures>
                                                        <PathFigure StartPoint="6,3" IsClosed="True">
                                                            <PathFigure.Segments>
                                                                <PolyLineSegment Points="22,12 6,21"/>
                                                            </PathFigure.Segments>
                                                        </PathFigure>
                                                    </PathGeometry.Figures>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        <!-- The pieces are arriving: without this the tap
                                             looks like it did nothing. -->
                                        <ProgressBar IsIndeterminate="True" Width="26" Height="4"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <!-- A voice note or an audio file: play/pause, a
                                     bar and the time. The transport is ours and
                                     not the system one, so nothing opens full
                                     screen and the conversation stays in view.
                                     The tap is the button: the border has no
                                     Tapped of its own, which is what kept the
                                     button and the border from both firing. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220" Height="56"
                                        Background="#FF263238"
                                        Visibility="{Binding IsAudio, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="6,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="IncomingPlayAudioButton" Grid.Column="0"
                                                Background="Transparent"
                                                MinWidth="0" MinHeight="0"
                                                Width="36" Height="36"
                                                BorderThickness="0" Padding="0"
                                                VerticalAlignment="Center"
                                                Click="IncomingPlayAudioButton_Click">
                                            <Grid>
                                                <Path Fill="White" Width="20" Height="20"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsAudioNotPlaying, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- IconPlay -->
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure StartPoint="6,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="22,12 6,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                </Path>
                                                <Path Fill="White" Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- IconPause -->
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure StartPoint="5,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="9,3 9,21 5,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                                <PathFigure StartPoint="15,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="19,3 19,21 15,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <ProgressBar Grid.Column="1"
                                                     Margin="8,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Height="4"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding PlaybackProgress}"
                                                     Background="#55FFFFFF"
                                                     Foreground="White"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlaybackTimeText}"
                                                   Foreground="#B0FFFFFF" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.ColumnSpan="3"
                                                   Text="{Binding AudioErrorText}"
                                                   Visibility="{Binding AudioFailed, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="White" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ProgressBar IsIndeterminate="True" Width="24" Height="4"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <!-- A document: a type badge, the name and the
                                     size, tapped to open it with the app the
                                     phone uses for that type. The name was
                                     already on the wire and the size is known
                                     once the bytes are all here; before that the
                                     card shows the name alone. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220"
                                        Background="#FF263238"
                                        Visibility="{Binding IsDocument, Converter={StaticResource BoolToVisibility}}"
                                        Tap="Media_Tapped">
                                    <Grid Margin="10,8,10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="0"
                                                Background="#FF37474F"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentBadge}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentTitle}"
                                                       Foreground="White" FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding MediaSizeText}"
                                                       Foreground="#B0FFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ProgressBar IsIndeterminate="True" Width="24" Height="4"
                                                      Grid.ColumnSpan="2"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding SenderName}" TextWrapping="NoWrap"
                                           Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{StaticResource ChatBubbleMetaBrush}" FontSize="13" Margin="0,0,0,3"
                                           TextTrimming="WordEllipsis"/>
                                <TextBlock Text="{Binding ShownText}" TextWrapping="Wrap"
                                           Visibility="{Binding ShowsText, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="White" FontSize="18"/>
                                <TextBlock Text="{Binding FormattedTime}"
                                           HorizontalAlignment="Right" Margin="0,3,0,0"
                                           Foreground="{StaticResource ChatBubbleMetaBrush}" FontSize="13"/>
                            </StackPanel>
                        </Border>

                        <!-- Outgoing bubble: the accent colour, white text, and the
                             same square corner as the received one. -->
                        <!-- The same 15 x 10 tail, turned to hang under the
                             bottom-right corner: the received bubble's tail is at
                             the top-left, the sent one mirrors it downward. -->
                        <Polygon Points="0,0 15,0 15,10" Fill="{StaticResource ChatOutgoingBrush}"
                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Margin="0,0,0,0"
                                 Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVisibility}}"/>
                        <Border Background="{StaticResource ChatOutgoingBrush}"
                                CornerRadius="0"
                                MaxWidth="324"
                                Margin="0,0,0,10"
                                HorizontalAlignment="Right"
                                Visibility="{Binding IsOutgoing, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Margin="10,6,10,4">
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Visibility="{Binding Type, Converter={StaticResource MsgTypeToImageVis}}"
                                        MaxWidth="300" MaxHeight="200"
                                        Tap="Media_Tapped">
                                    <Image Source="{Binding MediaImage}"
                                           Stretch="UniformToFill"
                                           HorizontalAlignment="Center"/>
                                </Border>
                                <!-- A video: a dark box with the triangle, tapped
                                     to open it full screen. Before the bytes it is
                                     the same tap that fetches them. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220" Height="140"
                                        Background="#FF263238"
                                        Visibility="{Binding IsVideo, Converter={StaticResource BoolToVisibility}}"
                                        Tap="Media_Tapped">
                                    <Grid>
                                        <!-- The cover frame, when the phone could
                                             make one: with it the box says which
                                             video it is. Without it the dark box
                                             and the triangle stay. -->
                                        <Image Source="{Binding VideoThumbnail}"
                                               Stretch="UniformToFill"
                                               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                        <Path Fill="White" Width="54" Height="54"
                                              HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <!-- IconPlay -->
                                            <Path.Data>
                                                <PathGeometry>
                                                    <PathGeometry.Figures>
                                                        <PathFigure StartPoint="6,3" IsClosed="True">
                                                            <PathFigure.Segments>
                                                                <PolyLineSegment Points="22,12 6,21"/>
                                                            </PathFigure.Segments>
                                                        </PathFigure>
                                                    </PathGeometry.Figures>
                                                </PathGeometry>
                                            </Path.Data>
                                        </Path>
                                        <!-- The pieces are arriving: without this the tap
                                             looks like it did nothing. -->
                                        <ProgressBar IsIndeterminate="True" Width="26" Height="4"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <!-- A voice note or an audio file: play/pause, a
                                     bar and the time. The transport is ours and
                                     not the system one, so nothing opens full
                                     screen and the conversation stays in view.
                                     The tap is the button: the border has no
                                     Tapped of its own, which is what kept the
                                     button and the border from both firing. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220" Height="56"
                                        Background="#FF263238"
                                        Visibility="{Binding IsAudio, Converter={StaticResource BoolToVisibility}}">
                                    <Grid Margin="6,0,6,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="OutgoingPlayAudioButton" Grid.Column="0"
                                                Background="Transparent"
                                                MinWidth="0" MinHeight="0"
                                                Width="36" Height="36"
                                                BorderThickness="0" Padding="0"
                                                VerticalAlignment="Center"
                                                Click="OutgoingPlayAudioButton_Click">
                                            <Grid>
                                                <Path Fill="White" Width="20" Height="20"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsAudioNotPlaying, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- IconPlay -->
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure StartPoint="6,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="22,12 6,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                </Path>
                                                <Path Fill="White" Width="18" Height="18"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsPlaying, Converter={StaticResource BoolToVisibility}}">
                                                    <!-- IconPause -->
                                                    <Path.Data>
                                                        <PathGeometry>
                                                            <PathGeometry.Figures>
                                                                <PathFigure StartPoint="5,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="9,3 9,21 5,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                                <PathFigure StartPoint="15,3" IsClosed="True">
                                                                    <PathFigure.Segments>
                                                                        <PolyLineSegment Points="19,3 19,21 15,21"/>
                                                                    </PathFigure.Segments>
                                                                </PathFigure>
                                                            </PathGeometry.Figures>
                                                        </PathGeometry>
                                                    </Path.Data>
                                                </Path>
                                            </Grid>
                                        </Button>
                                        <ProgressBar Grid.Column="1"
                                                     Margin="8,0,8,0"
                                                     VerticalAlignment="Center"
                                                     Height="4"
                                                     Minimum="0" Maximum="1"
                                                     Value="{Binding PlaybackProgress}"
                                                     Background="#55FFFFFF"
                                                     Foreground="White"/>
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding PlaybackTimeText}"
                                                   Foreground="#B0FFFFFF" FontSize="11"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.ColumnSpan="3"
                                                   Text="{Binding AudioErrorText}"
                                                   Visibility="{Binding AudioFailed, Converter={StaticResource BoolToVisibility}}"
                                                   Foreground="White" FontSize="12"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ProgressBar IsIndeterminate="True" Width="24" Height="4"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <!-- A document: a type badge, the name and the
                                     size, tapped to open it with the app the
                                     phone uses for that type. The name was
                                     already on the wire and the size is known
                                     once the bytes are all here; before that the
                                     card shows the name alone. -->
                                <Border CornerRadius="0"
                                        Margin="0,0,0,4"
                                        Width="220"
                                        Background="#FF263238"
                                        Visibility="{Binding IsDocument, Converter={StaticResource BoolToVisibility}}"
                                        Tap="Media_Tapped">
                                    <Grid Margin="10,8,10,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Width="40" Height="40" CornerRadius="0"
                                                Background="#FF37474F"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentBadge}"
                                                       Foreground="White" FontSize="11" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DocumentTitle}"
                                                       Foreground="White" FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="WordEllipsis"/>
                                            <TextBlock Text="{Binding MediaSizeText}"
                                                       Foreground="#B0FFFFFF" FontSize="11"
                                                       Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ProgressBar IsIndeterminate="True" Width="24" Height="4"
                                                      Grid.ColumnSpan="2"
                                                      Foreground="White"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Visibility="{Binding IsMediaLoading, Converter={StaticResource BoolToVisibility}}"/>
                                    </Grid>
                                </Border>
                                <!-- The text follows the accent too: white when the accent is
                                     dark (the usual case), #333 when it is light, which is what
                                     Accent.Apply puts in WhatsAppAccentTextBrush. A fixed white
                                     was unreadable on a light accent. -->
                                <TextBlock Text="{Binding SenderName}" TextWrapping="NoWrap"
                                           Visibility="{Binding IsGroup, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="{StaticResource ChatBubbleMetaBrush}" FontSize="13" Margin="0,0,0,3"
                                           TextTrimming="WordEllipsis"/>
                                <TextBlock Text="{Binding ShownText}" TextWrapping="Wrap"
                                           Visibility="{Binding ShowsText, Converter={StaticResource BoolToVisibility}}"
                                           Foreground="White" FontSize="18"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,3,0,0"
                                            Opacity="0.8">
                                    <TextBlock Text="{Binding FormattedTime}"
                                               Foreground="{StaticResource ChatBubbleMetaBrush}" FontSize="13"/>
                                    <!-- One tick sent, two delivered, two blue read: the glyph
                                         comes from the status converter and the colour from
                                         `MsgStatusToColor`, which is why this used to stay
                                         white for "read" too (2026-11-01). -->
                                    <TextBlock Text="{Binding Status, Converter={StaticResource MsgStatusToString}}"
                                               Foreground="{Binding Status, Converter={StaticResource MsgStatusToColor}}"
                                               FontSize="12" Margin="4,0,0,0"/>
                                </StackPanel>
                                <!-- The send failed and the bubble says it: the way out is
                                     here and not in the keyboard. It sends the same text or
                                     the same file again on the same bubble, so a retry is not
                                     a second message; `CanRetry` hides it when the file a
                                     media retry needs is gone, and when the status changes
                                     back to sending. No Width: the WP8.1 theme minimums
                                     (109 x 57.5) would otherwise decide the bubble's size,
                                     hence the two zeroes. -->
                                <Button x:Name="RetryMessageButton"
                                        HorizontalAlignment="Right"
                                        Margin="0,2,0,0"
                                        Padding="0"
                                        MinWidth="0" MinHeight="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Click="RetryMessageButton_Click"
                                        Visibility="{Binding CanRetry, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Text="{Binding Status, Converter={StaticResource LocalizedMessageText}, ConverterParameter=ChatPage_Retry.Text}"
                                               FontSize="12"
                                               Foreground="{StaticResource WhatsAppAccentTextBrush}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>
        </phone:LongListSelector>

        <!-- WhatsApp's arrow back to the newest message, over the conversation
             in the bottom left. One 44x44 target: the dark circle and the down
             chevron. It is shown and hidden by the page from the view's own
             position, never by a binding, and it starts hidden because a
             conversation that opens at its newest message has nothing below. -->
        <Button x:Name="RecentMessagesButton" Grid.Row="1"
                HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="12,0,0,12"
                Width="44" Height="44"
                MinWidth="0" MinHeight="0"
                Padding="0"
                BorderThickness="0"
                Background="Transparent"
                Visibility="Collapsed"
                Click="RecentMessagesButton_Click">
            <Grid Width="44" Height="44">
                <Ellipse Width="44" Height="44" Fill="#FF455A64"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Path Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      StrokeLineJoin="Round"
                      Width="24" Height="24"
                      HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- IconArrowDown -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="6,9">
                                    <PathFigure.Segments>
                                        <LineSegment Point="12,16"/>
                                        <LineSegment Point="18,9"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Grid>
        </Button>

        <!-- Someone is writing: the same bubble as a message of theirs, with the
             three dots of WhatsApp instead of words. It is shown and hidden by
             the page, never by a binding, because only the page knows whether it
             is the conversation on screen. -->
        <Grid x:Name="TypingBar" Grid.Row="2"
              Background="Transparent"
              Visibility="Collapsed">
            <Border Background="{StaticResource WhatsAppReceivedBubbleBrush}"
                    CornerRadius="0"
                    Padding="14,13,14,11"
                    Margin="4,2,4,2"
                    HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="TypingDot1" Width="7" Height="7" Fill="#FF9E9E9E">
                        <Ellipse.RenderTransform>
                            <CompositeTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="TypingDot2" Width="7" Height="7" Margin="5,0,0,0" Fill="#FF9E9E9E">
                        <Ellipse.RenderTransform>
                            <CompositeTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                    <Ellipse x:Name="TypingDot3" Width="7" Height="7" Margin="5,0,0,0" Fill="#FF9E9E9E">
                        <Ellipse.RenderTransform>
                            <CompositeTransform/>
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Input area: the white strip of the official app, with the box a
             shade darker so the field reads as a field. -->
        <Grid Grid.Row="3" Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Selected image preview -->
            <Grid x:Name="ImagePreviewBar" Grid.Row="0" Height="64"
                  Background="#FF292929" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image x:Name="SelectedImagePreview" Grid.Column="0"
                       Width="48" Height="48" Margin="8,8,0,8"
                       Stretch="UniformToFill"/>
                <!-- A video is not decoded: the box says what is being sent
                     without drawing anything. -->
                <Path x:Name="SelectedVideoPreview" Grid.Column="0"
                      Width="30" Height="30" Margin="17,17,0,17"
                      Fill="White"
                      Visibility="Collapsed">
                    <!-- IconPlay -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="6,3" IsClosed="True">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="22,12 6,21"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <!-- A voice note: the microphone glyph, where an image shows
                     its thumbnail. Nothing is decoded for it. -->
                <Path x:Name="SelectedAudioPreview" Grid.Column="0"
                      Width="30" Height="30" Margin="17,17,0,17"
                      Fill="White"
                      Visibility="Collapsed">
                    <!-- IconMicrophone -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="10,7" IsClosed="True">
                                    <PathFigure.Segments>
                                        <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                    SweepDirection="Clockwise" Point="14,7"/>
                                        <LineSegment Point="14,12"/>
                                        <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                    SweepDirection="Clockwise" Point="10,12"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                                <PathFigure StartPoint="7,11">
                                    <PathFigure.Segments>
                                        <ArcSegment Size="5,5" RotationAngle="0" IsLargeArc="False"
                                                    SweepDirection="Counterclockwise" Point="17,11"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                                <PathFigure StartPoint="12,16">
                                    <PathFigure.Segments>
                                        <LineSegment Point="12,19"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                                <PathFigure StartPoint="9,19">
                                    <PathFigure.Segments>
                                        <LineSegment Point="15,19"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                <!-- A document: the badge and the name, drawn where an image
                     shows its thumbnail. -->
                <Border x:Name="SelectedDocumentPreview" Grid.Column="0"
                        Width="40" Height="40" Margin="12,12,0,12" CornerRadius="0"
                        Background="#FF37474F"
                        Visibility="Collapsed">
                    <TextBlock x:Name="SelectedDocumentPreviewText"
                               Text=""
                               Foreground="White" FontSize="9" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               TextTrimming="WordEllipsis"/>
                </Border>
                <TextBlock x:Name="PreviewLabel" Grid.Column="1"
                           Text=""
                           VerticalAlignment="Center"
                           Foreground="#FFE0E8E8" FontSize="13"
                           Margin="8,0,0,0"/>
                <Button x:Name="ClearImageButton" Grid.Column="2"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="44" Height="44" BorderThickness="0" Padding="0"
                        Click="ClearImageButton_Click">
                    <Path Stroke="#FF9BAEB0" StrokeThickness="2.4"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Width="24" Height="24">
                        <!-- IconClose -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="6,6">
                                        <PathFigure.Segments>
                                            <LineSegment Point="18,18"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="18,6">
                                        <PathFigure.Segments>
                                            <LineSegment Point="6,18"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Button>
            </Grid>

            <!-- Recording: a red dot and the elapsed time. It shares row 0 with
                 the preview bar and never shows together with it. -->
            <Grid x:Name="RecordingBar" Grid.Row="0" Height="64"
                  Background="#FF292929" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Ellipse Grid.Column="0" Width="12" Height="12"
                         Margin="16,0,0,0" VerticalAlignment="Center"
                         Fill="#FFE53935"/>
                <TextBlock x:Name="RecordingLabelText" Grid.Column="1"
                           Text=""
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#FFE0E8E8" FontSize="13"/>
                <TextBlock x:Name="RecordTimerText" Grid.Column="2"
                           Text=""
                           VerticalAlignment="Center" Margin="8,0,0,0"
                           Foreground="#FFE0E8E8" FontSize="13"/>
            </Grid>

            <!-- Input row -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                <Button x:Name="RecordButton" Grid.Column="0"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4"
                        Click="RecordButton_Click">
                    <Grid Width="40" Height="40">
                    <Ellipse Width="40" Height="40" Stroke="White" StrokeThickness="1.5"/>
                    <Path Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="24" Height="24">
                        <!-- IconMicrophone -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="10,7" IsClosed="True">
                                        <PathFigure.Segments>
                                            <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                        SweepDirection="Clockwise" Point="14,7"/>
                                            <LineSegment Point="14,12"/>
                                            <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="False"
                                                        SweepDirection="Clockwise" Point="10,12"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="7,11">
                                        <PathFigure.Segments>
                                            <ArcSegment Size="5,5" RotationAngle="0" IsLargeArc="False"
                                                        SweepDirection="Counterclockwise" Point="17,11"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="12,16">
                                        <PathFigure.Segments>
                                            <LineSegment Point="12,19"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="9,19">
                                        <PathFigure.Segments>
                                            <LineSegment Point="15,19"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    </Grid>
                </Button>
                <Button x:Name="StopRecordButton" Grid.Column="0"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4"
                        Visibility="Collapsed"
                        Click="StopRecordButton_Click">
                    <Path Fill="#FFE53935" Width="20" Height="20">
                        <!-- IconStop -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="6,6" IsClosed="True">
                                        <PathFigure.Segments>
                                            <PolyLineSegment Points="18,6 18,18 6,18"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Button>
                <Button x:Name="MentionButton" Grid.Column="1"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="40" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4" Visibility="Collapsed"
                        Content="@" FontSize="20" Foreground="White"
                        Click="MentionButton_Click"/>

                <Grid Grid.Column="2">
                <Border x:Name="InputBubble" Margin="0,0,4,0" Background="#FFCCCCCC" CornerRadius="0">
                    <Grid>
                    <TextBlock x:Name="MessagePlaceholderText"
                               Text=""
                               IsHitTestVisible="False"
                               VerticalAlignment="Center"
                               Margin="12,0,4,0"
                               Foreground="#FF777777"
                               FontSize="20"/>
                    <TextBox x:Name="MessageTextBox"
                             Text=""
                         VerticalAlignment="Center"
                         MinHeight="40"
                         TextWrapping="Wrap"
                         FontSize="20"
                         Background="Transparent"
                         BorderThickness="0"
                         KeyDown="MessageTextBox_KeyDown"
                         KeyUp="MessageTextBox_KeyUp"
                         AcceptsReturn="False"
                         TextChanged="MessageTextBox_TextChanged"
                         Foreground="#FF333333">
                    <!-- The scope is what puts the emoji key on the keyboard: Windows
                         Phone 8.1 shows the smiley next to the space bar only for `Chat`,
                         and with it the keyboard turns a typed `:)` into the emoji it has.
                         Without the scope the composer was a plain text box, so the one
                         keyboard everybody types on offered neither. -->
                    <TextBox.InputScope>
                        <InputScope>
                            <InputScope.Names>
                                <InputScopeName NameValue="Chat"/>
                            </InputScope.Names>
                        </InputScope>
                    </TextBox.InputScope>
                    </TextBox>
                    </Grid>
                </Border>
                <!-- The little tail the reference composer hangs under the right
                     end of the speech-shaped input box. -->
                <Path Fill="#FFCCCCCC" Width="10" Height="8"
                      HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,2,0" IsHitTestVisible="False">
                    <!-- IconBubbleTail -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="0,0" IsClosed="True">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="10,0 4,8"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
                </Grid>

                </Grid>

                <!-- The ring bar of the reference: the circles sit centred and the
                     overflow dots hang at the right edge. -->
                <Grid Grid.Row="2" Background="#FF222222" MinHeight="64">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="SendButton" 
                        Background="Transparent"
                        Foreground="White"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48"
                        Margin="0,4,8,4"
                        BorderThickness="0" Padding="0"
                        Click="SendButton_Click">
                    <Grid Width="44" Height="44">
                    <Ellipse Width="44" Height="44" Stroke="White" StrokeThickness="1.5"/>
                    <Path Stroke="White" StrokeThickness="2" Width="24" Height="24"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- IconSend -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="3,5" IsClosed="True">
                                        <PathFigure.Segments>
                                            <PolyLineSegment Points="21,5 21,19 3,19"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="7,9">
                                        <PathFigure.Segments>
                                            <LineSegment Point="17,9"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="7,12">
                                        <PathFigure.Segments>
                                            <LineSegment Point="17,12"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                    <PathFigure StartPoint="7,15">
                                        <PathFigure.Segments>
                                            <LineSegment Point="12,15"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    </Grid>
                </Button>
                <Button x:Name="AttachButton" 
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4"
                        Click="AttachButton_Click">
                    <Grid Width="40" Height="40">
                    <Ellipse Width="40" Height="40" Stroke="White" StrokeThickness="1.5"/>
                    <Path Stroke="White" StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="24" Height="24"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- IconAttach -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="9,18">
                                        <PathFigure.Segments>
                                            <LineSegment Point="9,7.5"/>
                                            <ArcSegment Size="3,3" RotationAngle="0" IsLargeArc="True"
                                                        SweepDirection="Clockwise" Point="15,7.5"/>
                                            <LineSegment Point="15,15"/>
                                            <ArcSegment Size="2,2" RotationAngle="0" IsLargeArc="True"
                                                        SweepDirection="Clockwise" Point="11,15"/>
                                            <LineSegment Point="11,9.5"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                    </Grid>
                </Button>
                <!-- The call button lives in the ring bar, where the official
                     client puts it: it calls the person of this conversation and
                     hides for a group, because this client calls one at a time. -->
                <Button x:Name="CallHeaderButton" 
                        Background="Transparent" BorderThickness="0"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" Margin="0,0,12,0" Padding="0"
                        VerticalAlignment="Center"
                        Click="CallHeaderButton_Click">
                    <Path Fill="White" Width="24" Height="24"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- IconCall -->
                        <Path.Data>
                            <PathGeometry>
                                <PathGeometry.Figures>
                                    <PathFigure StartPoint="19.5,20" IsClosed="True">
                                        <PathFigure.Segments>
                                            <BezierSegment Point1="11.7,20" Point2="4,12.3" Point3="4,4.5"/>
                                            <LineSegment Point="7.5,4.5"/>
                                            <LineSegment Point="9,9"/>
                                            <LineSegment Point="7,11"/>
                                            <BezierSegment Point1="8.5,13.5" Point2="10.5,15.5" Point3="13,17"/>
                                            <LineSegment Point="15,15"/>
                                            <LineSegment Point="19.5,16.5"/>
                                        </PathFigure.Segments>
                                    </PathFigure>
                                </PathGeometry.Figures>
                            </PathGeometry>
                        </Path.Data>
                    </Path>
                </Button>
                <Button x:Name="SmileyButton"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4"
                        Click="SmileyButton_Click">
                    <Grid Width="40" Height="40">
                    <Ellipse Width="40" Height="40" Stroke="White" StrokeThickness="1.5"/>
                    <Grid Width="22" Height="22">
                        <Ellipse Width="3" Height="3" Fill="White"
                                 HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,5,0,0"/>
                        <Ellipse Width="3" Height="3" Fill="White"
                                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,4,0"/>
                        <Path Stroke="White" StrokeThickness="2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- IconSmiley -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="4,9">
                                            <PathFigure.Segments>
                                                <ArcSegment Size="7,7" RotationAngle="0" IsLargeArc="False"
                                                            SweepDirection="Clockwise" Point="18,9"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Grid>
                    </Grid>
                </Button>
                    </StackPanel>
                <Button x:Name="MoreButton"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48" BorderThickness="0" Padding="0"
                        Margin="0,4,0,4"
                        Click="MoreButton_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                        <Ellipse Width="4" Height="4" Fill="White" Margin="2,0"/>
                    </StackPanel>
                </Button>
                </Grid>
        </Grid>

        <!-- The voice-note player. One for the whole page, not one per bubble:
             a MediaElement per row of a virtualizing list is a decoder per row.
             It is 1x1 and transparent instead of Collapsed, because a collapsed
             MediaElement is not laid out and on this platform it does not play.
             Its transport is ours, in the bubble. -->
        <MediaElement x:Name="VoicePlayer"
                      Width="1" Height="1"
                      Opacity="0"
                      IsHitTestVisible="False"
                      HorizontalAlignment="Left" VerticalAlignment="Top"
                      AutoPlay="False"
                      MediaOpened="VoicePlayer_MediaOpened"
                      MediaEnded="VoicePlayer_MediaEnded"
                      MediaFailed="VoicePlayer_MediaFailed"/>

        <Grid x:Name="ImageViewer" Grid.RowSpan="4"
              Background="#F0000000"
              Visibility="Collapsed"
              Tap="ImageViewer_Tapped">
            <Image x:Name="ImageViewerImage" Stretch="Uniform"/>
        </Grid>

        <!-- A full-screen video. The transport controls are the system ones, so
             there is play/pause/bar without drawing them: that is what WhatsApp
             does. It closes with the X, and the X is a button like the others,
             with its name in the handler. -->
        <Grid x:Name="VideoViewer" Grid.RowSpan="4"
              Background="Black"
              Visibility="Collapsed">
            <MediaElement x:Name="VideoPlayer"
                          AutoPlay="True"
                          Stretch="Uniform"
                          MediaOpened="VideoPlayer_MediaOpened"
                          MediaEnded="VideoPlayer_MediaEnded"
                          MediaFailed="VideoPlayer_MediaFailed"/>
            <Grid x:Name="VideoTransportPanel"
                  Height="56"
                  VerticalAlignment="Bottom"
                  Background="#CC091518"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="VideoPlaybackButton" Grid.Column="0"
                        IsEnabled="False"
                        Background="Transparent"
                        MinWidth="0" MinHeight="0"
                        Width="48" Height="48"
                        BorderThickness="0" Padding="0"
                        Click="VideoPlaybackButton_Click">
                    <Grid>
                        <Path x:Name="VideoPlayIcon" Fill="White" Width="20" Height="20"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Visibility="Collapsed">
                            <!-- IconPlay -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="6,3" IsClosed="True">
                                            <PathFigure.Segments>
                                                <PolyLineSegment Points="22,12 6,21"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                        <Path x:Name="VideoPauseIcon" Fill="White" Width="18" Height="18"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                            <!-- IconPause -->
                            <Path.Data>
                                <PathGeometry>
                                    <PathGeometry.Figures>
                                        <PathFigure StartPoint="5,3" IsClosed="True">
                                            <PathFigure.Segments>
                                                <PolyLineSegment Points="9,3 9,21 5,21"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                        <PathFigure StartPoint="15,3" IsClosed="True">
                                            <PathFigure.Segments>
                                                <PolyLineSegment Points="19,3 19,21 15,21"/>
                                            </PathFigure.Segments>
                                        </PathFigure>
                                    </PathGeometry.Figures>
                                </PathGeometry>
                            </Path.Data>
                        </Path>
                    </Grid>
                </Button>
                <Slider x:Name="VideoSeekSlider" Grid.Column="1"
                        Minimum="0" Maximum="1" Value="0"
                        IsEnabled="False"
                        VerticalAlignment="Center"
                        Margin="8,0,16,0"
                        Foreground="{StaticResource WhatsAppAccentBrush}"
                        ValueChanged="VideoSeekSlider_ValueChanged"/>
            </Grid>
            <Button x:Name="VideoCloseButton"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48"
                    Margin="0,8,8,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    BorderThickness="0" Padding="0"
                    Click="VideoCloseButton_Click">
                <Path Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="24" Height="24">
                    <!-- IconClose -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="6,6">
                                    <PathFigure.Segments>
                                        <LineSegment Point="18,18"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                                <PathFigure StartPoint="18,6">
                                    <PathFigure.Segments>
                                        <LineSegment Point="6,18"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>
            <TextBlock x:Name="VideoErrorText"
                       Text=""
                       Foreground="White"
                       FontSize="15"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Margin="24,0,24,0"
                       Visibility="Collapsed"/>
        </Grid>

        <!-- Each entry opens the phone's continuation-based file picker with a
             matching filter; the selection still reaches AttachmentInbox. -->
        <Grid x:Name="AttachmentPickerOverlay" Grid.RowSpan="4"
              Background="#B0000000"
              Visibility="Collapsed">
            <Button x:Name="AttachmentPickerDismissButton"
                    Background="Transparent"
                    BorderThickness="0"
                    MinWidth="0" MinHeight="0"
                    Click="AttachmentPickerDismissButton_Click"/>
            <Border Width="400"
                    MaxWidth="460"
                    Padding="12"
                    Background="#FF242424"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock x:Name="AttachmentPickerTitle"
                               Text=""
                               Foreground="White"
                               FontSize="22"
                               Margin="8,0,8,12"
                               TextWrapping="Wrap"/>
                    <Grid HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="AttachmentAlbumsButton" Grid.Row="0" Grid.Column="0"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentAlbumsButton_Click">
                            <TextBlock x:Name="AttachmentAlbumsLabel" Text=""
                                       FontSize="13" TextWrapping="Wrap"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                        <Button x:Name="AttachmentPhotoButton" Grid.Row="0" Grid.Column="1"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentPhotoButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="White" StrokeThickness="1.8" Width="28" Height="24"
                                      HorizontalAlignment="Center">
                                    <!-- IconPhoto -->
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="3.5,5.5" IsClosed="True">
                                                    <PathFigure.Segments>
                                                        <PolyLineSegment Points="20.5,5.5 20.5,18.5 3.5,18.5"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="3.5,15">
                                                    <PathFigure.Segments>
                                                        <PolyLineSegment Points="8.5,10 12.5,14 15.5,11.5 20.5,15.5"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="7.5,8">
                                                    <PathFigure.Segments>
                                                        <ArcSegment Size="1.3,1.3" RotationAngle="0" IsLargeArc="True"
                                                                    SweepDirection="Clockwise" Point="7.5,10.6"/>
                                                        <ArcSegment Size="1.3,1.3" RotationAngle="0" IsLargeArc="True"
                                                                    SweepDirection="Clockwise" Point="7.5,8"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock x:Name="AttachmentPhotoLabel" Text=""
                                           FontSize="19" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AttachmentVideoButton" Grid.Row="0" Grid.Column="2"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentVideoButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="White" Width="28" Height="28" HorizontalAlignment="Center">
                                    <!-- IconPlay -->
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="6,3" IsClosed="True">
                                                    <PathFigure.Segments>
                                                        <PolyLineSegment Points="22,12 6,21"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock x:Name="AttachmentVideoLabel" Text=""
                                           FontSize="19" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AttachmentAudioButton" Grid.Row="1" Grid.Column="0"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentAudioButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="White" StrokeThickness="2" Width="28" Height="28"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center">
                                    <!-- IconAudio -->
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="16,4">
                                                    <PathFigure.Segments>
                                                        <LineSegment Point="16,18"/>
                                                        <BezierSegment Point1="16,22" Point2="9,23" Point3="7,20"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="16,5">
                                                    <PathFigure.Segments>
                                                        <LineSegment Point="22,7"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="16,10">
                                                    <PathFigure.Segments>
                                                        <LineSegment Point="21,12"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock x:Name="AttachmentAudioLabel" Text=""
                                           FontSize="19" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AttachmentLocationButton" Grid.Row="1" Grid.Column="1"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentLocationButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="White" StrokeThickness="1.8" Width="28" Height="28"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center">
                                    <!-- IconLocation -->
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="14,24.5" IsClosed="True">
                                                    <PathFigure.Segments>
                                                        <LineSegment Point="5.5,11.5"/>
                                                        <ArcSegment Size="8.5,8.5" RotationAngle="0" IsLargeArc="True"
                                                                    SweepDirection="Clockwise" Point="22.5,11.5"/>
                                                        <LineSegment Point="14,24.5"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="14,8.5" IsClosed="True">
                                                    <PathFigure.Segments>
                                                        <ArcSegment Size="2.6,2.6" RotationAngle="0" IsLargeArc="True"
                                                                    SweepDirection="Clockwise" Point="14,13.7"/>
                                                        <ArcSegment Size="2.6,2.6" RotationAngle="0" IsLargeArc="True"
                                                                    SweepDirection="Clockwise" Point="14,8.5"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock x:Name="AttachmentLocationLabel" Text=""
                                           FontSize="17" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="AttachmentContactButton" Grid.Row="1" Grid.Column="2"
                                Width="112" Height="112" MinWidth="0" MinHeight="0"
                                Margin="4" Padding="8" BorderThickness="0"
                                Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                                Click="AttachmentContactButton_Click">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Stroke="White" StrokeThickness="1.8" Width="28" Height="28"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" HorizontalAlignment="Center">
                                    <!-- IconContact -->
                                    <Path.Data>
                                        <PathGeometry>
                                            <PathGeometry.Figures>
                                                <PathFigure StartPoint="12,3" IsClosed="True">
                                                    <PathFigure.Segments>
                                                        <ArcSegment Size="4,4" RotationAngle="0" IsLargeArc="False"
                                                                    SweepDirection="Clockwise" Point="12,11"/>
                                                        <ArcSegment Size="4,4" RotationAngle="0" IsLargeArc="False"
                                                                    SweepDirection="Clockwise" Point="12,3"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                                <PathFigure StartPoint="4,22">
                                                    <PathFigure.Segments>
                                                        <ArcSegment Size="8,6" RotationAngle="0" IsLargeArc="False"
                                                                    SweepDirection="Clockwise" Point="20,22"/>
                                                    </PathFigure.Segments>
                                                </PathFigure>
                                            </PathGeometry.Figures>
                                        </PathGeometry>
                                    </Path.Data>
                                </Path>
                                <TextBlock x:Name="AttachmentContactLabel" Text=""
                                           FontSize="17" TextWrapping="Wrap"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Margin="0,6,0,0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
