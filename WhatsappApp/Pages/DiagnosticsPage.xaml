<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="#FF000000">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent" Foreground="White"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,6,0,0" Padding="0"
                    Click="BackButton_Click" BorderThickness="0">
                <Path Stroke="#FFFFFFFF" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="PageTitleText" Grid.Column="1"
                       Foreground="White" FontSize="54" FontFamily="Segoe WP Semilight"
                       VerticalAlignment="Bottom" Margin="8,-10,0,-6"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HintText" Grid.Row="0" Foreground="#FFB0B0B0"
                       FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBox x:Name="DiagnosticsText" Grid.Row="1"
                     IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     Foreground="#FFE0E0E0" Background="#FF0D0D0D" BorderBrush="#FF333333"
                     BorderThickness="1" Padding="12"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ClearButton" Content=""
                        Background="#FF242424" Foreground="#FF00AFA9" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Click="ClearButton_Click"/>
                <Button x:Name="SelectAllButton" Content=""
                        Background="#FF242424" Foreground="#FF00AFA9" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Margin="8,0,0,0" Click="SelectAllButton_Click"/>
                <Button x:Name="ShareButton" Content=""
                        Background="#FF242424" Foreground="#FF00AFA9" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Margin="8,0,0,0" Click="ShareButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="ActionStatusText" Grid.Row="4"
                       Foreground="#FFB0B0B0" FontSize="12" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
