<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.DiagnosticsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The 54 px title of every secondary page, at the reference margin, and
             no chevron: the way back is the hardware key, as on Settings. -->
        <StackPanel Grid.Row="0" Background="Transparent">
            <TextBlock x:Name="PageTitleText"
                       Foreground="White" FontSize="54" FontFamily="Segoe WP Semilight"
                       Margin="24,-8,24,0"
                       TextTrimming="WordEllipsis"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="HintText" Grid.Row="0" Foreground="#FFB0B0B0"
                       FontSize="20" TextWrapping="Wrap" Margin="0,0,0,8"/>

            <TextBox x:Name="DiagnosticsText" Grid.Row="1"
                     IsReadOnly="True" AcceptsReturn="True"
                     TextWrapping="Wrap" FontFamily="Consolas" FontSize="12"
                     Foreground="#FFE0E0E0" Background="#FF0D0D0D" BorderBrush="#FF333333"
                     BorderThickness="1" Padding="12"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="ClearButton" Content=""
                        Background="#FF242424" Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Click="ClearButton_Click"/>
                <Button x:Name="SelectAllButton" Content=""
                        Background="#FF242424" Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Margin="8,0,0,0" Click="SelectAllButton_Click"/>
                <Button x:Name="ShareButton" Content=""
                        Background="#FF242424" Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="16"
                        MinWidth="0" MinHeight="0" Height="44" Width="96" BorderThickness="0"
                        Margin="8,0,0,0" Click="ShareButton_Click"/>
            </StackPanel>

            <TextBlock x:Name="ActionStatusText" Grid.Row="4"
                       Foreground="#FFB0B0B0" FontSize="20" TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
