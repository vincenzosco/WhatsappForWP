<Page
    x:Class="WhatsappApp.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFECE5DD">

    <Page.Resources>
        <SolidColorBrush x:Key="WhatsAppHeaderBrush" Color="#FF075E54"/>
        <SolidColorBrush x:Key="WhatsAppAccentBrush" Color="#FF25D366"/>
        <SolidColorBrush x:Key="WhatsAppGreenBrush" Color="#FF128C7E"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource WhatsAppHeaderBrush}" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,4,0,0" Padding="0"
                    Click="BackButton_Click"
                    BorderThickness="0">
                <Path Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="PageTitleText" Grid.Column="1" Text=""
                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0,0,4"/>
        </Grid>

        <!-- What this screen is: the account this phone is linked as, and the way back
             to the code that links it. Nothing about the server it talks through is
             here: an address, a port and a token are not something a person links, and
             a screen that shows them asks the reader to understand the plumbing. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,16">

                <TextBlock x:Uid="ConnectionPage_LinkedLabel" Text="Linked number"
                           Foreground="#FF075E54" FontSize="14" FontWeight="SemiBold"/>

                <Border x:Name="NumberPanel" Background="White" CornerRadius="8"
                        Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="AccountNumberText" Text=""
                               Foreground="#FF000000" FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="12"/>
                </Border>

                <!-- Shown instead of the number when there is none to show. -->
                <TextBlock x:Name="AccountHintText" x:Uid="ConnectionPage_NotLinked"
                           Text="This phone is not linked. Show the QR code to link it."
                           Foreground="#FF606060" FontSize="13" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,6,0,0"/>

                <Button x:Name="ShowQrButton" x:Uid="ConnectionPage_ShowQr"
                        Content="Show the QR code"
                        Background="{StaticResource WhatsAppAccentBrush}"
                        Foreground="White" FontSize="18" FontWeight="SemiBold"
                        Height="52" BorderThickness="0" Margin="0,16,0,0"
                        Click="ShowQrButton_Click"/>

                <!-- What the last press did: requesting, unavailable, or what went
                     wrong. A button that shows nothing is a button that looks dead. -->
                <TextBlock x:Name="QrStatusText" Text=""
                           Foreground="#FF606060" FontSize="12" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>

        <!-- Full-screen QR: the phone scans the code with WhatsApp, so it must be
             big, on a white background and with the screen kept on. -->
        <Grid x:Name="QrOverlay" Grid.RowSpan="2" Background="White" Visibility="Collapsed">
            <StackPanel VerticalAlignment="Center" Margin="16,16,16,16">
                <TextBlock x:Uid="ConnectionPage_QrOverlayTitle"
                           Text="Scan this code with WhatsApp"
                           Foreground="#FF075E54" FontSize="20" FontWeight="SemiBold"
                           TextAlignment="Center" TextWrapping="Wrap"/>
                <Image x:Name="QrOverlayImage" Width="340" Height="340" Margin="0,12,0,0"
                       Stretch="Uniform" HorizontalAlignment="Center"/>
                <!-- Text filled by the code-behind, which alternates the
                     instruction with "I am refreshing the code": that is why it
                     has no x:Uid and the .resw key has no suffix. -->
                <TextBlock x:Name="QrOverlayHintText" Text=""
                           Foreground="#FF606060" FontSize="13" TextAlignment="Center"
                           TextWrapping="Wrap" Margin="0,12,0,0"/>
                <Button x:Name="QrOverlayCloseButton" x:Uid="ConnectionPage_QrOverlayClose"
                        Content="Close"
                        Background="#FFE0E0E0" Foreground="#FF075E54" FontSize="16"
                        Height="44" BorderThickness="0" Margin="0,16,0,0"
                        Click="QrOverlayCloseButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
