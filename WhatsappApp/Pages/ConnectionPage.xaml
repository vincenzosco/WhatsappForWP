<Page
    x:Class="WhatsappApp.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#FFECE5DD">

    <Page.Resources>
        <SolidColorBrush x:Key="WhatsAppHeaderBrush" Color="#FF075E54"/>
        <SolidColorBrush x:Key="WhatsAppAccentBrush" Color="#FF25D366"/>
        <SolidColorBrush x:Key="WhatsAppGreenBrush" Color="#FF128C7E"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource WhatsAppHeaderBrush}" Height="56">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,4,0,0" Padding="0"
                    Click="BackButton_Click"
                    BorderThickness="0">
                <Path Stroke="White" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="PageTitleText" Grid.Column="1" Text=""
                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="8,0,0,4"/>
        </Grid>

        <!-- What this screen is: the account this phone is linked as, what the client
             is doing, and the way to a code that links a different one. Nothing about
             a server is here, because there is no server: the phone is the client. -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,16,16,16">

                <TextBlock x:Uid="ConnectionPage_LinkedLabel" Text="Linked number"
                           Foreground="#FF075E54" FontSize="14" FontWeight="SemiBold"/>

                <Border x:Name="NumberPanel" Background="White" CornerRadius="8"
                        Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="AccountNumberText" Text=""
                               Foreground="#FF000000" FontSize="24" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="12"/>
                </Border>

                <!-- Shown instead of the number when there is none to show. -->
                <TextBlock x:Name="AccountHintText" x:Uid="ConnectionPage_NotLinked"
                           Text="This phone is not linked. Tap below to show the QR code."
                           Foreground="#FF606060" FontSize="13" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,6,0,0"/>

                <TextBlock x:Uid="ConnectionPage_StatusLabel" Text="Connection"
                           Foreground="#FF075E54" FontSize="14" FontWeight="SemiBold"
                           Margin="0,20,0,0"/>

                <!-- The client's own sentence about what it is doing. It is written by
                     NativeConnection and it is deliberately not translated: it is the
                     same line the log carries (see the diagnostics page). -->
                <TextBlock x:Name="StatusText" Text=""
                           Foreground="#FF000000" FontSize="14" TextWrapping="Wrap"
                           Margin="0,6,0,0"/>

                <!-- The one action this screen still has. It has no x:Uid on the Path
                     rule: an x:Uid on a Button overwrites its Content (see
                     maintain-the-app). -->
                <Button x:Name="LinkDeviceButton" x:Uid="ConnectionPage_LinkDevice"
                        Content="Link a device"
                        Background="{StaticResource WhatsAppAccentBrush}"
                        Foreground="White" FontSize="18" FontWeight="SemiBold"
                        Height="52" BorderThickness="0" Margin="0,24,0,0"
                        Click="LinkDeviceButton_Click"/>

                <TextBlock x:Uid="ConnectionPage_LinkDeviceHint"
                           Text="Linking a device replaces the account this phone uses."
                           Foreground="#FF606060" FontSize="12" TextWrapping="Wrap"
                           Margin="0,8,0,0"/>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
