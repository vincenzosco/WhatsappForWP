<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.ConnectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image x:Name="PageWallpaper" Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="2" Fill="#CC000000"/>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent" Foreground="White"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,6,0,0" Padding="0"
                    Click="BackButton_Click" BorderThickness="0">
                <Path Stroke="#FFFFFFFF" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="PageTitleText" Grid.Column="1"
                       Foreground="White" FontSize="54" FontFamily="Segoe WP Semilight"
                       VerticalAlignment="Bottom" Margin="8,-10,0,-6"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,16,24,16">
                <TextBlock x:Name="LinkedLabel" Foreground="White"
                           FontSize="24"/>

                <Border x:Name="NumberPanel"
                        Margin="0,6,0,0" Visibility="Collapsed">
                    <TextBlock x:Name="AccountNumberText" Foreground="White"
                               FontSize="30" FontFamily="Segoe WP Semilight"
                               TextWrapping="Wrap" Margin="0"/>
                </Border>

                <TextBlock x:Name="AccountHintText" Foreground="#FFB0B0B0"
                           FontSize="20" TextWrapping="Wrap"
                           Visibility="Collapsed" Margin="0,6,0,0"/>

                <TextBlock x:Name="StatusLabel" Foreground="White"
                           FontSize="24" Margin="0,20,0,0"/>

                <TextBlock x:Name="StatusText" Foreground="White"
                           FontSize="24" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <Button x:Name="LinkDeviceButton" Content=""
                        Background="{StaticResource WhatsAppAccentBrush}" Foreground="White"
                        FontSize="18" FontWeight="SemiBold"
                        MinWidth="0" MinHeight="0" Height="52"
                        BorderThickness="0" Margin="0,24,0,0"
                        Click="LinkDeviceButton_Click"/>

                <TextBlock x:Name="LinkDeviceHint" Foreground="#FFB0B0B0"
                           FontSize="20" TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</phone:PhoneApplicationPage>
