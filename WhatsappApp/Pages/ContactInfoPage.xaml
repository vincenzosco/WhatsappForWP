<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.ContactInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image x:Name="PageWallpaper" Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="2" Fill="#E6000000"/>

        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent" Foreground="White"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,4,0,0" Padding="0"
                    Click="BackButton_Click" BorderThickness="0">
                <Path Stroke="#FFFFFFFF" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="TitleText" Grid.Column="1"
                       VerticalAlignment="Bottom" Margin="8,0,0,8"
                       Foreground="White" FontSize="20" FontWeight="SemiBold"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <Button x:Name="CallButton" Click="CallButton_Click"
                        Background="Transparent" Foreground="#FF00A8C7" BorderThickness="0"
                        MinWidth="0" MinHeight="0" Height="48" Padding="20,0"
                        FontSize="17" Margin="24,12,24,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>

                <Grid Margin="24,20,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BigAvatar" Grid.Column="0"
                            Width="128" Height="128" CornerRadius="64"
                            VerticalAlignment="Bottom" Margin="0,0,24,0"
                            MouseLeftButtonUp="BigAvatar_Tapped">
                        <Grid>
                            <Ellipse x:Name="BigAvatarCircle" Width="128" Height="128"
                                     Fill="#FF00695C"/>
                            <Border x:Name="BigAvatarPicture" Width="128" Height="128"
                                    CornerRadius="64" Visibility="Collapsed">
                                <Border.Background>
                                    <ImageBrush x:Name="BigAvatarImageBrush" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock x:Name="BigAvatarInitials"
                                       Foreground="White" FontSize="44" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="NameText" Grid.Column="1"
                               FontSize="36" FontFamily="Segoe WP Semilight"
                               Foreground="White"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"
                               TextTrimming="WordEllipsis"/>
                </Grid>

                <TextBlock x:Name="NumberLabel" FontSize="14"
                           Foreground="#FF9C9C9C" Margin="24,24,24,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="NumberText" FontSize="20" Foreground="White" FontFamily="Segoe WP Semilight"
                           Margin="24,2,24,0" Visibility="Collapsed"/>

                <TextBlock x:Name="AboutLabel" FontSize="14"
                           Foreground="#FF9C9C9C" Margin="24,24,24,0" Visibility="Collapsed"/>
                <TextBlock x:Name="AboutText" FontSize="20" Foreground="White" FontFamily="Segoe WP Semilight"
                           TextWrapping="Wrap" Margin="24,2,24,0" Visibility="Collapsed"/>

                <StackPanel x:Name="BusinessPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="BusinessLabel" FontSize="18" FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="BusinessEmailLabel" FontSize="13" Foreground="#FF9C9C9C"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessEmailText" FontSize="16" Foreground="White"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressLabel" FontSize="13" Foreground="#FF9C9C9C"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressText" FontSize="16" Foreground="White"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesLabel" FontSize="13" Foreground="#FF9C9C9C"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesText" FontSize="16" Foreground="White"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessHoursLabel" FontSize="13" Foreground="#FF9C9C9C"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="HoursList" SelectionMode="Single" IsHitTestVisible="False"
                             MaxHeight="240" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="White"
                                           FontSize="16" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel x:Name="GroupPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="GroupDescriptionLabel" FontSize="18" FontWeight="SemiBold"
                               Foreground="White" Visibility="Collapsed"/>
                    <TextBlock x:Name="GroupDescriptionText" FontSize="16" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="MembersLabel" FontSize="20" FontWeight="SemiBold"
                               Foreground="White" Margin="0,18,0,0"/>
                    <ListBox x:Name="MembersList" SelectionMode="Single" IsHitTestVisible="False"
                             MaxHeight="320" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                                               Foreground="White" FontSize="20"
                                               FontFamily="Segoe WP Semilight" TextTrimming="WordEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Role}"
                                               Foreground="#FF00A8C7" FontSize="13"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <TextBlock x:Name="EmptyText" FontSize="15" Foreground="#FF9C9C9C"
                           TextWrapping="Wrap" Margin="24,24,24,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ImageViewer" Grid.RowSpan="2"
              Background="#F0000000" Visibility="Collapsed"
              MouseLeftButtonUp="ImageViewer_Tapped">
            <Image x:Name="ImageViewerImage" Stretch="Uniform"/>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
