<phone:PhoneApplicationPage
    x:Class="WhatsappApp.Pages.ContactInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    Background="#FF000000">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Image x:Name="PageWallpaper" Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="2" Fill="#E6000000"/>

        <StackPanel Grid.Row="0" Background="Transparent">
            <TextBlock x:Name="CategoryText" Text="" Foreground="White"
                       FontSize="15" FontWeight="SemiBold" Margin="24,14,24,2"/>
            <TextBlock x:Name="TitleText" Text="" Foreground="White"
                       FontSize="54" FontFamily="Segoe WP Semilight"
                       Margin="24,-8,24,0" TextTrimming="WordEllipsis"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,24">
                <TextBlock x:Name="ProfileHeading" Foreground="White" FontSize="24"
                           Margin="24,8,24,0"/>

                <Grid Margin="24,12,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BigAvatar" Grid.Column="0"
                            Width="160" Height="160"
                            VerticalAlignment="Bottom" Margin="0,0,24,0"
                            MouseLeftButtonUp="BigAvatar_Tapped">
                        <Grid>
                            <Rectangle x:Name="BigAvatarCircle" Width="160" Height="160"
                                       Fill="#FF00695C"/>
                            <Rectangle x:Name="BigAvatarPicture" Width="160" Height="160"
                                       Visibility="Collapsed">
                                <Rectangle.Fill>
                                    <ImageBrush x:Name="BigAvatarImageBrush" Stretch="UniformToFill"/>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="BigAvatarInitials"
                                       Foreground="White" FontSize="44" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>
                </Grid>

                <Button x:Name="CallButton" Click="CallButton_Click"
                        Background="Transparent" Foreground="{StaticResource WhatsAppAccentBrush}" BorderThickness="0"
                        MinWidth="0" MinHeight="0" Height="48" Padding="20,0"
                        FontSize="24" Margin="24,12,24,0"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"/>

                <TextBlock x:Name="NumberLabel" FontSize="24"
                           Foreground="White" Margin="24,24,24,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="NumberText" FontSize="20" Foreground="#FFB0B0B0"
                           Margin="24,2,24,0" Visibility="Collapsed"/>

                <TextBlock x:Name="AboutLabel" FontSize="24"
                           Foreground="White" Margin="24,24,24,0" Visibility="Collapsed"/>
                <TextBlock x:Name="AboutText" FontSize="20" Foreground="#FFB0B0B0"
                           TextWrapping="Wrap" Margin="24,2,24,0" Visibility="Collapsed"/>

                <StackPanel x:Name="BusinessPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="BusinessLabel" FontSize="24"
                               Foreground="White"/>
                    <TextBlock x:Name="BusinessEmailLabel" FontSize="24" Foreground="White"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessEmailText" FontSize="20" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressLabel" FontSize="24" Foreground="White"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressText" FontSize="20" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesLabel" FontSize="24" Foreground="White"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesText" FontSize="20" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessHoursLabel" FontSize="24" Foreground="White"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <ListBox x:Name="HoursList" SelectionMode="Single" IsHitTestVisible="False"
                             MaxHeight="240" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="#FFB0B0B0"
                                           FontSize="20" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <StackPanel x:Name="GroupPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="GroupDescriptionLabel" FontSize="24"
                               Foreground="White" Visibility="Collapsed"/>
                    <TextBlock x:Name="GroupDescriptionText" FontSize="20" Foreground="#FFB0B0B0"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <TextBlock x:Name="MembersLabel" FontSize="28" FontFamily="Segoe WP Semilight"
                                   Foreground="White"/>
                        <TextBlock x:Name="MembersCountText" FontSize="28" FontFamily="Segoe WP Semilight"
                                   Foreground="{StaticResource WhatsAppAccentBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                    <ListBox x:Name="MembersList" SelectionMode="Single" IsHitTestVisible="False"
                             MaxHeight="320" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                                               Foreground="White" FontSize="28"
                                               FontFamily="Segoe WP Semilight" TextTrimming="WordEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Role}"
                                               Foreground="{StaticResource WhatsAppAccentBrush}" FontSize="13"
                                               Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <TextBlock x:Name="EmptyText" FontSize="20" Foreground="#FF9C9C9C"
                           TextWrapping="Wrap" Margin="24,24,24,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Grid x:Name="ImageViewer" Grid.RowSpan="2"
              Background="#F0000000" Visibility="Collapsed"
              MouseLeftButtonUp="ImageViewer_Tapped">
            <Image x:Name="ImageViewerImage" Stretch="Uniform"/>
        </Grid>
    </Grid>
</phone:PhoneApplicationPage>
