<Page
    x:Class="WhatsappApp.Pages.ContactInfoPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WhatsappApp.Converters"
    Background="White">

    <Page.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- The chosen wallpaper, under the same veil the home list uses: opening a
             person's details is not leaving the app, and a white page here reads as
             another app. Collapsed for the plain white theme. -->
        <Image x:Name="PageWallpaper" Grid.RowSpan="2"
               Stretch="UniformToFill"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        <Rectangle Grid.RowSpan="2"
                   Fill="{StaticResource WhatsAppHomeVeilBrush}"/>

        <!-- Header: back + title. As on the other pages, the bar is drawn here
             and the handler writes the title with Loc.Get. -->
        <!-- Transparent and not white: the header sits on the wallpaper and its veil. -->
        <Grid Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BackButton" Grid.Column="0"
                    Background="Transparent"
                    MinWidth="0" MinHeight="0"
                    Width="48" Height="48" Margin="0,4,0,0" Padding="0"
                    Click="BackButton_Click"
                    BorderThickness="0">
                <Path Stroke="#FF333333" StrokeThickness="2.4"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Width="24" Height="24">
                    <!-- IconBack -->
                    <Path.Data>
                        <PathGeometry>
                            <PathGeometry.Figures>
                                <PathFigure StartPoint="15.5,4">
                                    <PathFigure.Segments>
                                        <PolyLineSegment Points="7.5,12 15.5,20"/>
                                    </PathFigure.Segments>
                                </PathFigure>
                            </PathGeometry.Figures>
                        </PathGeometry>
                    </Path.Data>
                </Path>
            </Button>

            <TextBlock x:Name="TitleText" Grid.Column="1"
                       VerticalAlignment="Bottom" Margin="8,-10,0,-6"
                       Foreground="#FF333333" FontSize="54" FontFamily="Segoe WP Semilight"
                       TextTrimming="WordEllipsis"/>
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Margin="0,0,0,24">

                <!-- The way out of this page and into a call. One button, and its
                     word is written by the handler: the label is a string of the app,
                     like every other label here. -->
                <Button x:Name="CallButton" Click="CallButton_Click"
                        Background="#FF25D366" Foreground="White" BorderThickness="0"
                        MinWidth="0" MinHeight="0" Height="44" Padding="20,0"
                        FontSize="16" Margin="24,12,24,0"
                        HorizontalAlignment="Stretch"/>

                <!-- The header of the released profile page: the picture 128 px at
                     24 from the edge, a 24 px gap, and the name sitting on the
                     picture's baseline. It is a Border and not an Image for the same
                     reason as the list row: WP8.1 clips a circle only with the
                     CornerRadius of a background. -->
                <Grid Margin="24,20,24,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="BigAvatar" Grid.Column="0"
                            Width="128" Height="128" CornerRadius="64"
                            VerticalAlignment="Bottom" Margin="0,0,24,0"
                            Tapped="BigAvatar_Tapped">
                        <Grid>
                            <Ellipse Width="128" Height="128"
                                     Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                            <Border Width="128" Height="128" CornerRadius="64"
                                    Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Avatar}" Stretch="UniformToFill"/>
                                </Border.Background>
                            </Border>
                            <TextBlock Text="{Binding Initials}"
                                       Foreground="White" FontSize="44" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding HasAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        </Grid>
                    </Border>

                    <TextBlock x:Name="NameText" Grid.Column="1"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="#FF333333"
                               VerticalAlignment="Bottom" Margin="0,0,0,2"
                               TextTrimming="WordEllipsis"/>
                </Grid>

                <TextBlock x:Name="NumberLabel" FontSize="24" FontWeight="SemiBold"
                           Foreground="#FF333333" Margin="24,24,24,0"
                           Visibility="Collapsed"/>
                <TextBlock x:Name="NumberText" FontSize="24" Foreground="#FF333333"
                           Margin="24,2,24,0"
                           Visibility="Collapsed"/>

                <TextBlock x:Name="AboutLabel" FontSize="24" FontWeight="SemiBold"
                           Foreground="#FF333333" Margin="24,24,24,0" Visibility="Collapsed"/>
                <TextBlock x:Name="AboutText" FontSize="24" Foreground="#FF333333"
                           TextWrapping="Wrap" Margin="24,2,24,0" Visibility="Collapsed"/>

                <StackPanel x:Name="BusinessPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="BusinessLabel" FontSize="18" FontWeight="SemiBold"
                               Foreground="#FF333333"/>
                    <TextBlock x:Name="BusinessEmailLabel" FontSize="13" Foreground="#FF939393"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessEmailText" FontSize="16" Foreground="#FF333333"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressLabel" FontSize="13" Foreground="#FF939393"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessAddressText" FontSize="16" Foreground="#FF333333"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesLabel" FontSize="13" Foreground="#FF939393"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessCategoriesText" FontSize="16" Foreground="#FF333333"
                               TextWrapping="Wrap" Visibility="Collapsed"/>
                    <TextBlock x:Name="BusinessHoursLabel" FontSize="13" Foreground="#FF939393"
                               Margin="0,10,0,0" Visibility="Collapsed"/>
                    <ListView x:Name="HoursList" SelectionMode="None" IsHitTestVisible="False"
                              MaxHeight="240">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Display}" Foreground="#FF333333"
                                           FontSize="16" TextWrapping="Wrap" Margin="0,2,0,2"/>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel x:Name="GroupPanel" Visibility="Collapsed" Margin="24,24,24,0">
                    <TextBlock x:Name="GroupDescriptionLabel" FontSize="18" FontWeight="SemiBold"
                               Foreground="#FF333333" Visibility="Collapsed"/>
                    <TextBlock x:Name="GroupDescriptionText" FontSize="16" Foreground="#FF333333"
                               TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="MembersLabel" FontSize="18" FontWeight="SemiBold"
                               Foreground="#FF333333" Margin="0,18,0,0"/>
                    <ListView x:Name="MembersList" SelectionMode="None" IsHitTestVisible="False"
                              MaxHeight="320">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Display}"
                                               Foreground="#FF333333" FontSize="16"
                                               TextTrimming="WordEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Role}"
                                               Foreground="#FF939393" FontSize="13"
                                               Margin="8,0,0,0"
                                               Visibility="{Binding IsRoleVisible, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <TextBlock x:Name="EmptyText" FontSize="15" Foreground="#FF939393"
                           TextWrapping="Wrap" Margin="24,24,24,0" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <!-- The full-screen picture: it closes on tap, as for a bubble. -->
        <Grid x:Name="ImageViewer" Grid.RowSpan="2"
              Background="#F0000000"
              Visibility="Collapsed"
              Tapped="ImageViewer_Tapped">
            <Image x:Name="ImageViewerImage" Stretch="Uniform"/>
        </Grid>
    </Grid>
</Page>
