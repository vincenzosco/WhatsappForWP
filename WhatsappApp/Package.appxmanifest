<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="7ccc5b77-3cf2-4020-92a7-9542b250bb49" Publisher="CN=Vincenzo" Version="1.3.12.12" />
  <mp:PhoneIdentity PhoneProductId="7ccc5b77-3cf2-4020-92a7-9542b250bb49" PhonePublisherId="00000000-0000-0000-0000-000000000000" />
  <Properties>
    <DisplayName>WhatsApp</DisplayName>
    <PublisherDisplayName>Vincenzo</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="x-generate" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="WhatsappApp.App">
      <!-- BackgroundColor #45D82C: il verde dell'icona ufficiale, cosi' la
           tile e la barra di avvio sono lo stesso marchio e non un riquadro
           bianco attorno a un logo. ForegroundText light e' la meta' che serve
           insieme a quel verde: il testo della tile dev'essere bianco. -->
      <m3:VisualElements DisplayName="WhatsApp" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png" Description="WhatsApp per Windows Phone 8.1" ForegroundText="light" BackgroundColor="#45D82C">
        <m3:DefaultTile Wide310x150Logo="Assets\WideLogo.png" Square71x71Logo="Assets\Square71x71Logo.png">
        </m3:DefaultTile>
        <m3:SplashScreen Image="Assets\SplashScreen.png" />
        <!-- Lo schermo di blocco: Windows mostra il badge (stato rapido, con
             l'icona dell'app) oppure il tile largo (stato dettagliato, con il
             testo dei messaggi). Quale dei due l'utente sceglie in Impostazioni
             > Schermo di blocco; l'app deve solo dichiararsi qui e tenere
             aggiornati badge e tile. Senza il background task qui sotto Windows
             non elenca l'app in quelle impostazioni. -->
        <m3:LockScreen Notification="badgeAndTileText" BadgeLogo="Assets\LockScreenBadge.png" />
      </m3:VisualElements>
      <Extensions>
        <Extension Category="windows.backgroundTasks" EntryPoint="WhatsappApp.BackgroundSyncTask">
          <BackgroundTasks>
            <Task Type="timer" />
          </BackgroundTasks>
        </Extension>
        <Extension Category="windows.shareTarget" Executable="$targetnametoken$.exe" EntryPoint="WhatsappApp.App">
          <ShareTarget>
            <SupportedFileTypes>
              <FileType>.jpg</FileType>
              <FileType>.jpeg</FileType>
              <FileType>.png</FileType>
              <FileType>.gif</FileType>
              <FileType>.bmp</FileType>
              <FileType>.mp4</FileType>
              <FileType>.mov</FileType>
              <FileType>.3gp</FileType>
              <FileType>.avi</FileType>
              <FileType>.mkv</FileType>
              <FileType>.webm</FileType>
            </SupportedFileTypes>
            <DataFormat>Bitmap</DataFormat>
            <DataFormat>StorageItems</DataFormat>
          </ShareTarget>
        </Extension>
        <!-- Il controllo periodico dei messaggi mentre l'app e' sospesa. Il
             tipo e' timer: il sistema lo sveglia ogni 15 minuti, che e' il
             minimo che accetta (un numero piu' basso non registra niente) e
             l'ora esatta non e' garantita. -->
        <!-- Riceve immagini e video condivisi da un'altra app (Galleria,
                 Foto, browser). Va dichiarato qui: senza questa estensione
                 WP8.1 non elenca l'app nel pannello di condivisione, e senza i
                 tipi dei video l'app non viene nemmeno offerta per loro. -->
        <!-- Senza prefisso: ShareTarget sta nel namespace predefinito di
                 questa manifest (appx/2010), come Extensions e Extension. Con
                 m3: il validatore risponde APPX3030/APPX3002. -->
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="removableStorage" />
    <m3:Capability Name="contacts" />
    <DeviceCapability Name="microphone" />
    <!-- Serve per ricevere i beacon UDP dell'adapter sulla rete locale. -->
    <!-- Il microfono del vocale. E' una DeviceCapability e non una Capability:
             senza di essa MediaCapture.InitializeAsync risponde accesso negato e
             la registrazione non parte mai. -->
  </Capabilities>
</Package>