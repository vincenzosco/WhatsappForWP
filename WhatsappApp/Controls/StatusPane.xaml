<UserControl
    x:Class="WhatsappApp.Controls.StatusPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WhatsappApp.Converters">

    <UserControl.Resources>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <conv:MessageTypeToImageVisibilityConverter x:Key="MsgTypeToImageVis"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style x:Key="StatusItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ListView x:Name="StatusListView"
                  ItemContainerStyle="{StaticResource StatusItemContainerStyle}"
                  Background="Transparent"
                  SelectionMode="None"
                  IsItemClickEnabled="True"
                  ItemClick="Status_Click">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="76" Background="Transparent" Margin="24,0,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="62"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="52" Height="52"
                              Margin="-2,10,-2,10" VerticalAlignment="Top">
                            <!-- The ring is what the row says about itself: a person with
                                 anything unwatched is ringed in the accent, and the ring goes
                                 when the viewer has sent its `read` for the last of them.
                                 Without it a list of yesterday's updates looks exactly like
                                 a list of new ones. -->
                            <Ellipse Width="52" Height="52" StrokeThickness="2"
                                     Stroke="{StaticResource WhatsAppAccentBrush}"
                                     Visibility="{Binding IsStatusViewed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                            <Ellipse Width="48" Height="48"
                                     Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                            <TextBlock Text="{Binding Initials}"
                                       Foreground="White" FontSize="18" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- One row per person: `Latest` is their newest update, and
                             `Detail` says either "3 updates" or the words of the only one. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,10,0,10">
                            <TextBlock Text="{Binding Latest.SenderName}" Foreground="#FF333333" FontSize="20"
                                       FontWeight="SemiBold" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF939393" FontSize="17"
                                       TextWrapping="Wrap" MaxLines="3" TextTrimming="WordEllipsis"/>
                            <Border CornerRadius="4" Margin="0,4,0,0"
                                    Visibility="{Binding Latest.Type, Converter={StaticResource MsgTypeToImageVis}}"
                                    MaxWidth="220" MaxHeight="160" HorizontalAlignment="Left">
                                <Image Source="{Binding Latest.MediaImage}" Stretch="UniformToFill"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding Latest.FormattedTime}" Foreground="#FF939393"
                                   FontSize="17" VerticalAlignment="Top" Margin="8,16,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty and still-filling are two different things, and only a row says
             the difference (the same rule as the page this pane came from). -->
        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320">
            <Path Stroke="#FFBDBDBD" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="48" Height="48" Stretch="Uniform" HorizontalAlignment="Center">
                <!-- IconStatus -->
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="12,4" IsClosed="True">
                                <PathFigure.Segments>
                                    <ArcSegment Size="8,8" RotationAngle="0" IsLargeArc="True"
                                                SweepDirection="Clockwise" Point="12,20"/>
                                    <ArcSegment Size="8,8" RotationAngle="0" IsLargeArc="True"
                                                SweepDirection="Clockwise" Point="12,4"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="12,7.5">
                                <PathFigure.Segments>
                                    <PolyLineSegment Points="12,12.3 16,14.5"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
            <TextBlock x:Uid="StatusPage_EmptyTitle" Text="No status updates"
                       Foreground="#FF9E9E9E" FontSize="16"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Uid="StatusPage_EmptyHint" Text="Updates your contacts post appear here, and tapping one tells them you have seen it."
                       Foreground="#FFBDBDBD" FontSize="13" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" Margin="0,2,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
