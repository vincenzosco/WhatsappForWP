<UserControl
    x:Class="WhatsappApp.Controls.StatusPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:conv="clr-namespace:WhatsappApp.Converters">

    <UserControl.Resources>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid Background="Black">
        <phone:LongListSelector x:Name="StatusListView" Background="Transparent"
                                SelectionChanged="Status_Click">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="68" Background="Transparent" Margin="24,12,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="68" Height="68" VerticalAlignment="Top">
                            <Ellipse Width="78" Height="78" StrokeThickness="2"
                                     Stroke="{StaticResource WhatsAppAccentBrush}"
                                     Visibility="{Binding IsStatusViewed, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                            <Ellipse Width="68" Height="68" Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                            <Ellipse Width="68" Height="68"
                                     Visibility="{Binding Owner.HasAvatar, Converter={StaticResource BoolToVisibility}}">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding Owner.Avatar}" Stretch="UniformToFill"/>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="26"
                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"
                                       Visibility="{Binding Owner.HasAvatar, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="18,0,0,0">
                            <TextBlock Text="{Binding Latest.SenderName}" Foreground="White" FontSize="32"
                                       FontFamily="Segoe WP Semilight" TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF939393" FontSize="20"
                                       TextWrapping="Wrap" TextTrimming="WordEllipsis" MaxHeight="72"/>
                            <Border MaxWidth="220" MaxHeight="160" CornerRadius="4" Margin="0,4,0,0"
                                    HorizontalAlignment="Left"
                                    Visibility="{Binding ShowPreview, Converter={StaticResource BoolToVisibility}}">
                                <Image Source="{Binding Latest.MediaImage}" Stretch="UniformToFill"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding Latest.FormattedTime}" Foreground="#FF939393"
                                   FontSize="20" VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>
        </phone:LongListSelector>

        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="300">
            <Ellipse Width="40" Height="40" Stroke="#FF566061" StrokeThickness="2"
                     HorizontalAlignment="Center"/>
            <TextBlock x:Name="EmptyTitle" Foreground="#FFB0B0B0" FontSize="17"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock x:Name="EmptyHint" Foreground="#FF787878" FontSize="13"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
