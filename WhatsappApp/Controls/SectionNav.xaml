<UserControl
    x:Class="WhatsappApp.Controls.SectionNav"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <!-- App bar buttons: the released WP8 app had a bottom bar with icons
             and no floating button. -->
        <Style x:Key="NavIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <!-- WP8.1 gives a Button 109 x 57.5: without the two minimums at 0
                 the height declared below is ignored and the buttons spill out
                 of the 48 px bar. -->
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Height" Value="48"/>
            <!-- The theme Button hugs its content instead of filling its cell:
                 each icon would sit at the left edge of its own star column,
                 so the three of them look shifted left together. Stretching the
                 button and centering its content puts each icon in the middle
                 of its column. -->
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#FFF5F5F5" Height="48">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="ChatsButton" Grid.Column="0"
                Style="{StaticResource NavIconButtonStyle}"
                Click="ChatsButton_Click">
            <Path x:Name="ChatsIcon" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="24" Height="24">
                <!-- IconChats -->
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="4,5" IsClosed="True">
                                <PathFigure.Segments>
                                    <PolyLineSegment Points="20,5 20,15.5 10.5,15.5 5.5,20 5.5,15.5 4,15.5"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Button>

        <Button x:Name="StatusButton" Grid.Column="1"
                Style="{StaticResource NavIconButtonStyle}"
                Click="StatusButton_Click">
            <Path x:Name="StatusIcon" StrokeThickness="2"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="24" Height="24">
                <!-- IconStatus -->
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="12,4" IsClosed="True">
                                <PathFigure.Segments>
                                    <ArcSegment Size="8,8" RotationAngle="0" IsLargeArc="True"
                                                SweepDirection="Clockwise" Point="12,20"/>
                                    <ArcSegment Size="8,8" RotationAngle="0" IsLargeArc="True"
                                                SweepDirection="Clockwise" Point="12,4"/>
                                </PathFigure.Segments>
                            </PathFigure>
                            <PathFigure StartPoint="12,7.5">
                                <PathFigure.Segments>
                                    <PolyLineSegment Points="12,12.3 16,14.5"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Button>

        <Button x:Name="CallsButton" Grid.Column="2"
                Style="{StaticResource NavIconButtonStyle}"
                Click="CallsButton_Click">
            <Path x:Name="CallsIcon" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                  Width="24" Height="24">
                <!-- IconCalls -->
                <Path.Data>
                    <PathGeometry>
                        <PathGeometry.Figures>
                            <PathFigure StartPoint="16.6,16.6">
                                <PathFigure.Segments>
                                    <ArcSegment Size="6.5,6.5" RotationAngle="0" IsLargeArc="False"
                                                SweepDirection="Clockwise" Point="7.4,7.4"/>
                                </PathFigure.Segments>
                            </PathFigure>
                        </PathGeometry.Figures>
                    </PathGeometry>
                </Path.Data>
            </Path>
        </Button>
    </Grid>
</UserControl>
