<UserControl
    x:Class="WhatsappApp.Controls.CallsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:phone="clr-namespace:Microsoft.Phone.Controls;assembly=Microsoft.Phone"
    xmlns:conv="clr-namespace:WhatsappApp.Converters">

    <UserControl.Resources>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <conv:MissedToBrushConverter x:Key="MissedToBrush"/>
    </UserControl.Resources>

    <Grid Background="Black">
        <phone:LongListSelector x:Name="CallsListView" Background="Transparent"
                                SelectionChanged="CallsListView_SelectionChanged">
            <phone:LongListSelector.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="68" Background="Transparent" Margin="24,24,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="74"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Width="68" Height="68" Margin="0,0,6,0"
                              VerticalAlignment="Center">
                            <Ellipse Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                            <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="26"
                                       FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Top" Margin="12,0,0,0" MaxHeight="68">
                            <TextBlock Text="{Binding Name}" FontSize="32" FontFamily="Segoe WP Semilight"
                                       Foreground="{Binding IsMissed, Converter={StaticResource MissedToBrush}}"
                                       TextTrimming="WordEllipsis"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF939393" FontSize="20"
                                       TextTrimming="WordEllipsis" MaxHeight="28"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#FF939393"
                                   FontSize="20" VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </phone:LongListSelector.ItemTemplate>
        </phone:LongListSelector>

        <TextBlock x:Name="StatusText" Foreground="#FF92999A" FontSize="14"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="290"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
    </Grid>
</UserControl>
