<UserControl
    x:Class="WhatsappApp.Controls.CallsPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:WhatsappApp.Converters">

    <UserControl.Resources>
        <conv:InitialToColorConverter x:Key="InitialToColor"/>
        <conv:MissedToBrushConverter x:Key="MissedToBrush"/>

        <Style x:Key="CallItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsTabStop" Value="False"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ListView x:Name="CallsListView"
                  ItemContainerStyle="{StaticResource CallItemContainerStyle}"
                  Background="Transparent"
                  SelectionMode="None">
            <ListView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </ListView.ItemsPanel>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <!-- The row of WhatsApp's own call log (CallLogItemControl): a 68 px
                         circle 6 px from the details, which start 12 px later still, the
                         name at 32 px SemiLight and the outcome under it at 20, and the
                         whole item 24 px down and 24 px in from the sides. -->
                    <Grid Background="Transparent" Margin="24,24,24,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Width="68" Height="68"
                              Margin="0,0,6,0" VerticalAlignment="Top">
                            <Ellipse Width="68" Height="68"
                                     Fill="{Binding Initials, Converter={StaticResource InitialToColor}}"/>
                            <TextBlock Text="{Binding Initials}"
                                       Foreground="White" FontSize="26" FontWeight="SemiBold"
                                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- The name sits high and the outcome right under it: the 32 px
                             title is lifted by the same 6 px its own control uses, so the
                             two lines read as one column against the 68 px picture. -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Top"
                                    Margin="12,0,0,0" MaxHeight="68">
                            <!-- A missed call is the red name: the row a person scans the log
                                 for, and the colour the released app gives it. -->
                            <TextBlock Text="{Binding Name}" FontSize="32" FontFamily="Segoe WP Semilight"
                                       Foreground="{Binding IsMissed, Converter={StaticResource MissedToBrush}}"
                                       TextTrimming="WordEllipsis" Margin="0,-6,0,0"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FF939393" FontSize="20"
                                       TextTrimming="WordEllipsis" MaxHeight="28"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="{Binding TimeText}" Foreground="#FF939393" FontSize="20"
                                   VerticalAlignment="Top" Margin="8,0,0,0"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- "Scanning" and "nothing to show" are two different things. -->
        <TextBlock x:Name="StatusText"
                   Foreground="#FF9E9E9E" FontSize="15"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="300"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Visibility="Collapsed"/>
    </Grid>
</UserControl>
