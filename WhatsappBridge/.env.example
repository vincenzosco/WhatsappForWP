# ── Server GOWA (go-whatsapp-web-multidevice) ────────────────────────────────
# URL del server GOWA avviato con:  ./whatsapp rest
GOWA_URL=http://127.0.0.1:3000

# Se GOWA è avviato con --basic-auth=utente:password, indica le credenziali.
GOWA_USER=
GOWA_PASS=

# Facoltativo: id di un device GOWA specifico (multi-device). Vuoto = device default.
GOWA_DEVICE_ID=

# ── Adapter verso l'app Windows Phone ───────────────────────────────────────
# Porta TCP sulla quale l'app WP8 si collega.
BRIDGE_PORT=8585

# Deve combaciare con la costante "Passphrase" di WhatsappApp/Services/CryptoHelper.cs,
# oppure con la chiave digitata nel campo "Chiave del server" dell'app.
# Il default e' pubblico: mettilo "on" solo con un BRIDGE_KEY tuo.
BRIDGE_KEY=WhatsAppCommunityWP8-2026
# Metti "on" per rifiutare di partire finche' BRIDGE_KEY e' il default pubblico.
BRIDGE_REQUIRE_KEY=off

# ── Accoppiamento (chiavi generate dal telefono) ────────────────────────────
# Il telefono genera da se' la chiave dei frame e il proprio token, e li consegna
# una volta sola: l'app ha i campi "Codice di accoppiamento" e "Invia la chiave al
# server", e il codice che il server stampa all'avvio sigilla quello scambio. Sul
# server non c'e' niente di segreto da digitare, e il deposito degli utenti tiene
# solo l'hash del token.
# Metti "on" per accettare una chiave generata dal telefono quando non ne esiste
# ancora una. Un server che ha gia' una chiave non apre la finestra.
PAIRING=off
# Quanto resta aperta la finestra di accoppiamento (minuti).
PAIRING_TTL_MIN=15
# Dove il server conserva la chiave ricevuta, cosi' un riavvio non chiede un nuovo
# accoppiamento. Vuoto = la chiave resta solo nell'ambiente.
BRIDGE_KEY_FILE=
# Metti "off" per disattivare la cifratura (protocollo in chiaro, sconsigliato).
BRIDGE_ENCRYPTION=on

# ── Scoperta automatica (adapter -> app) ────────────────────────────────────
# L'adapter si annuncia in UDP su questa porta, cosi' l'app WP8 lo trova da sola
# senza che si debba digitare indirizzo e porta.
DISCOVERY_PORT=8587
# Metti "off" per non annunciarsi (l'inserimento manuale nell'app resta).
DISCOVERY_ENABLED=on
# Nome mostrato nell'app; vuoto = nome del computer.
DISCOVERY_NAME=

# ── Webhook (GOWA -> adapter) ───────────────────────────────────────────────
WEBHOOK_PORT=8586
WEBHOOK_PATH=/webhook
# URL con cui GOWA raggiunge questo adapter. Necessario se GOWA non è sulla stessa macchina.
WEBHOOK_PUBLIC_URL=http://127.0.0.1:8586/webhook
# Deve combaciare con --webhook-secret di GOWA (default: "secret").
# Con un valore vuoto il webhook rifiuta ogni richiesta invece di fidarsi.
WEBHOOK_SECRET=secret

# ── Registro chiamate (GOWA -> adapter -> app) ──────────────────────────────
# GOWA registra solo le chiamate in entrata e non le espone nei webhook: l'adapter
# scorre le chat piu' recenti. Una richiesta HTTP per chat, quindi il limite e' la durata.
CALLS_CHAT_LIMIT=25
CALLS_MESSAGES_PER_CHAT=100
CALLS_LIMIT=50

# ── Elenco chat (GOWA -> adapter -> app) ────────────────────────────────────
# Le conversazioni vengono da /chats, non dalla rubrica WhatsApp (vuota su un
# dispositivo appena collegato): una richiesta per chat per l'ultimo messaggio,
# piu' una per persona per l'immagine del profilo.
CHATS_LIMIT=25
CHATS_AVATARS=on

# ── Storico di una chat (GOWA -> adapter -> app) ────────────────────────────
# Quanti messaggi caricare aprendo una chat. Una sola lettura, ma la risposta e'
# un frame per messaggio.
MESSAGES_LIMIT=50

# ── Vocali (ffmpeg) ─────────────────────────────────────────────────────────
# I vocali di WhatsApp sono Ogg/Opus e WP8.1 non ha un decoder Opus. L'adapter usa
# ffmpeg, se installato, per convertirli in MP3. Metti "off" per non provarci.
FFMPEG_ENABLED=on
# Percorso dell'eseguibile, quando non e' nel PATH.
FFMPEG_PATH=

# ── Registro dei server (adapter -> repo) ───────────────────────────────────
# L'app non ha un indirizzo solo: legge una lista (l'array "servers" di
# endpoint.json) e prova i server in ordine finche' uno risponde, cosi' un server
# che va giu' non porta giu' l'app. Con questo "on" l'adapter scrive la propria
# riga nel registro e la tiene fresca, cosi' l'app lo trova e puo' ripiegare su di
# lui. Spento per default: un'istanza privata non ha nessuno a cui annunciarsi, e
# pubblicare richiede un token.
ENDPOINT_PUBLISH=off
# Il repository dove vive il registro.
ENDPOINT_REPO=vincenzosco/whatsappforwp-endpoint
# Un token GitHub che puo' scrivere su ENDPOINT_REPO. Vuoto riprende GH_TOKEN e,
# se non c'e' nemmeno quello, si usa il `gh` della macchina: sul server basta
# `gh auth login` una volta e non serve salvare nessun token.
ENDPOINT_TOKEN=
# La riga che questo server possiede: due server non devono condividerla, o si
# sovrascrivono a vicenda. Vuoto = nome del computer.
ENDPOINT_SERVER_ID=
# Il nome mostrato nel registro; vuoto = l'id.
ENDPOINT_SERVER_NAME=
# L'indirizzo da annunciare, cioe' quello che il telefono chiama. Vuoto = il primo
# IPv4 locale, che va bene solo se l'adapter gira direttamente sull'host e non in
# un container bridged, dove quell'indirizzo e' di Docker: li' va messo l'IP reale.
ENDPOINT_HOST=
# La porta da annunciare; vuoto = BRIDGE_PORT.
ENDPOINT_PORT=
# Ogni quanto la riga viene riscritta (minuti), cosi' un indirizzo che si sposta
# con il DHCP viene ripreso.
ENDPOINT_PUBLISH_MINUTES=30
# Il registro condiviso sulla VM: con un URL qui l'adapter riporta la sua riga
# li' e non scrive piu' il repository, quindi non gli serve nessun token GitHub
# (nemmeno un `gh auth login`). Vuoto tiene la via diretta.
ENDPOINT_REGISTRY_URL=
# Il segreto condiviso che quel registro richiede (REGISTRY_TOKEN sulla VM).
ENDPOINT_REGISTRY_SECRET=
# Il token GitHub usato dal container tunnel (docker-compose.nas.yaml) per
# pubblicare l'indirizzo pubblico. L'adapter lo riprende se ENDPOINT_TOKEN e'
# vuoto, dato che un solo .env serve entrambi i servizi.
GH_TOKEN=

# ── Varie ───────────────────────────────────────────────────────────────────
# Intervallo di polling dello stato WhatsApp (ms).
POLL_INTERVAL_MS=5000
